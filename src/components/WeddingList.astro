---
// src/components/WeddingList.astro
import { getEventData } from "../data/eventData";
import backgroundImage from "../assets/images/ocean.jpg"; 
const { weddingList } = getEventData();
---

<section id="wedding-list"
  style={`background-image: url(${backgroundImage.src}); background-size: cover; background-position: center; position: relative;`}
  class="backgmontserrat relative py-24 overflow-hidden" 
  style="background: linear-gradient(to bottom, var(--color-primary) 40%, var(--color-watercolor) 100%);">
  
  <div class="mx-auto max-w-3xl w-[92%] px-6 text-center rounded-[2.5rem] p-10 shadow-2xl backdrop-blur-md border border-white/30"
      style="
        background-color: rgba(255, 255, 255, 0.4); "
        >
    
    <!-- Icona Simbolica: Aeroplanino di Carta -->
    <div class="mb-8 flex justify-center opacity-40">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="0.8" stroke="currentColor" class="size-14">
        <path stroke-linecap="round" stroke-linejoin="round" d="m20.893 13.393-1.135-1.135a2.252 2.252 0 0 1-.421-.585l-1.08-2.16a.414.414 0 0 0-.663-.107.827.827 0 0 1-.812.21l-1.273-.363a.89.89 0 0 0-.738 1.595l.587.39c.59.395.674 1.23.172 1.732l-.2.2c-.212.212-.33.498-.33.796v.41c0 .409-.11.809-.32 1.158l-1.315 2.191a2.11 2.11 0 0 1-1.81 1.025 1.055 1.055 0 0 1-1.055-1.055v-1.172c0-.92-.56-1.747-1.414-2.089l-.655-.261a2.25 2.25 0 0 1-1.383-2.46l.007-.042a2.25 2.25 0 0 1 .29-.787l.09-.15a2.25 2.25 0 0 1 2.37-1.048l1.178.236a1.125 1.125 0 0 0 1.302-.795l.208-.73a1.125 1.125 0 0 0-.578-1.315l-.665-.332-.091.091a2.25 2.25 0 0 1-1.591.659h-.18c-.249 0-.487.1-.662.274a.931.931 0 0 1-1.458-1.137l1.411-2.353a2.25 2.25 0 0 0 .286-.76m11.928 9.869A9 9 0 0 0 8.965 3.525m11.928 9.868A9 9 0 1 1 8.965 3.525" />
      </svg>
    </div>

    <h2 
      class="text-3xl sm:text-4xl font-semibold tracking-[0.2em] uppercase mb-6"
      style="color: var(--color-secondary);"
    >
      {weddingList.title}
    </h2>
    
    <div class="max-w-xl mx-auto mb-12">
      <p class="text-sm font-medium leading-relaxed opacity-80" style="color: var(--color-secondary);">
        {weddingList.message}
      </p>
      <p class="text-sm font-medium leading-relaxed opacity-70" style="color: var(--color-secondary);">
        {weddingList.message1}
      </p>
    </div>

  <div class="flex items-center justify-center gap-3 mb-6">
  <div class="h-px w-8 opacity-25" style="background: var(--color-secondary);"></div>
  <span class="text-sm uppercase tracking-[0.3em] opacity-80 font-semibold"
        style="color: var(--color-secondary);">
    Lista Nozze
  </span>
  <div class="h-px w-8 opacity-25" style="background: var(--color-secondary);"></div>
</div>
        
 <div
  id="copy-code-area"
  class="group relative bg-white/30 rounded-2xl px-6 py-5 mb-6 w-full
         border border-dashed border-white/50 cursor-pointer select-none
         transition-all duration-300 hover:bg-white/50 hover:shadow-md active:scale-[0.98]"
  role="button"
  aria-label="Tocca per copiare il codice di accesso"
  tabindex="0"
>
  <!-- Label fissa: cos'è -->
  <p class="text-[9px] uppercase tracking-[0.3em] mb-1 opacity-50 font-semibold"
     style="color: var(--color-secondary);">
    Codice di accesso
  </p>

  <!-- Il codice -->
  <code class="block font-bold text-base sm:text-lg font-mono tracking-widest my-2"
        style="color: var(--color-secondary);">
    <span id="code-to-copy">{weddingList.code}</span>
  </code>

  <!-- Hint interazione: cosa fare -->
  <p class="text-[9px] uppercase tracking-[0.2em] mt-1 opacity-40 flex items-center justify-center gap-1"
     style="color: var(--color-secondary);">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
    </svg>
    tocca per copiare
  </p>

  <!-- Feedback -->
  <span id="copy-feedback"
        class="block text-[9px] uppercase tracking-[0.2em] mt-1 opacity-0 transition-opacity duration-500"
        style="color: var(--color-secondary);">
    ✓ copiato!
  </span>
</div>

    <!-- Bottone per andare alla lista nozze -->
  <a
  href="http://www.firstviaggi.it/listanozze"
  target="_blank"
  rel="noopener noreferrer"
  class="group inline-flex items-center gap-2 px-10 py-4 rounded-full
         text-[10px] font-bold uppercase tracking-[0.25em]
         transition-all duration-300 shadow-md hover:shadow-lg active:scale-95
         border border-current/30 hover:bg-white/20"
  style="color: var(--color-secondary);"
>
  <span>Vai alla lista nozze</span>
  <!-- Icona freccia esterna -->
  <svg xmlns="http://www.w3.org/2000/svg" class="size-3 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
       fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
  </svg>
</a>
  </div>
</section>

<script>
  const setupWeddingList = () => {
    const copyArea = document.getElementById('copy-code-area');
    const codeText = document.getElementById('code-to-copy');
    const feedback = document.getElementById('copy-feedback');

    const doCopy = () => {
      if (!codeText || !feedback) return;
      navigator.clipboard.writeText(codeText.innerText.trim()).then(() => {
        feedback.style.opacity = '1';
        setTimeout(() => { feedback.style.opacity = '0'; }, 2000);
      });
    };

    if (copyArea) {
      copyArea.addEventListener('click', doCopy);
      copyArea.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          doCopy();
        }
      });
    }
  };

  setupWeddingList();
  document.addEventListener('astro:after-swap', setupWeddingList);
</script>