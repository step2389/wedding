---
import "../styles/global.css";
import Menu from "../components/Menu.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>Galleria Matrimonio Anna & Stefano</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,400&family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Menu />

    <main class="photo-page font-montserrat">
      <section class="gallery-shell" aria-label="I vostri scatti">
        <header class="gallery-topbar">
          <div class="gallery-topbar-inner">
            <div class="brand-title">
              <span class="gallery-subtitle">Matrimonio Anna & Stefano</span>
              <h1 class="gallery-title">Galleria</h1>
            </div>

            <div class="gallery-tools">
              <div class="gallery-count-badge" title="Foto totali">
                <svg class="count-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
                <span
                  id="photo-count"
                  class="gallery-count"
                  aria-label="Numero totale foto">0</span
                >
              </div>
            </div>
          </div>
        </header>

        <p
          id="message"
          class="gallery-message"
          role="status"
          aria-live="polite"
        >
        </p>

        <div class="gallery-grid-wrap">
          <div id="gallery-grid" class="gallery-grid"></div>
        </div>

        <div class="gallery-actions">
          <button id="load-more-btn" class="load-more-btn" type="button" hidden
            >Carica altre foto</button
          >
        </div>
      </section>

      <div class="upload-dock-wrap">
        <section class="upload-dock" aria-label="Carica nuove foto">
          <input
            id="camera-input"
            class="sr-only"
            type="file"
            accept="image/*"
            capture="environment"
          />
          <input
            id="gallery-input"
            class="sr-only"
            type="file"
            accept="image/*"
            multiple
          />

          <label
            for="camera-input"
            class="dock-action dock-action-secondary"
            title="Scatta foto con fotocamera"
          >
            <span class="dock-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M4 7h3l1.5-2h7L17 7h3v11H4z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
            </span>
            <span class="dock-copy">
              <span class="dock-label">Fotocamera</span>
              <span class="dock-sub">Scatta ora</span>
            </span>
          </label>

          <label
            for="gallery-input"
            class="dock-action dock-action-secondary"
            title="Scegli dalla galleria"
          >
            <span class="dock-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="4" y="5" width="16" height="14" rx="3"></rect>
                <path d="M8 14l2.5-2.5 2.5 2.5 3.5-4 3.5 4.5"></path>
                <circle cx="9" cy="9" r="1.2"></circle>
              </svg>
            </span>
            <span class="dock-copy">
              <span class="dock-label">Galleria</span>
              <span class="dock-sub">Seleziona</span>
            </span>
          </label>

          <button
            id="upload-btn"
            class="dock-action dock-action-primary"
            type="button"
            disabled
            title="Invia foto selezionate"
          >
            <span class="dock-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M12 16V6"></path>
                <path d="M8.5 9.5 12 6l3.5 3.5"></path>
                <path d="M5 18.5h14"></path>
              </svg>
            </span>
            <span class="dock-copy dock-copy-primary">
              <span id="upload-label" class="dock-label dock-label-strong"
                >Invia foto</span
              >
              <span id="upload-sub" class="dock-sub dock-sub-primary"
                >Seleziona prima</span
              >
            </span>
            <span id="upload-count" class="dock-badge" hidden>0</span>
          </button>
        </section>
      </div>
    </main>

    <div class="photo-footer-wrap">
      <Footer />
    </div>

    <dialog id="lightbox" class="photo-lightbox" aria-label="Foto ingrandita">
      <div class="photo-lightbox-inner">
        <button
          id="lightbox-close"
          class="photo-lightbox-close"
          type="button"
          aria-label="Chiudi immagine"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              d="M18 6L6 18M6 6l12 12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </button>

        <button
          id="lightbox-prev"
          class="photo-lightbox-nav prev"
          type="button"
          aria-label="Foto precedente"
          title="Foto precedente"
        >
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>

        <button
          id="lightbox-next"
          class="photo-lightbox-nav next"
          type="button"
          aria-label="Foto successiva"
          title="Foto successiva"
        >
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>

        <div class="photo-lightbox-media">
          <img
            id="lightbox-image"
            class="photo-lightbox-image"
            alt="Foto ingrandita"
          />
        </div>

        <div class="photo-lightbox-toolbar">
          <p id="lightbox-caption" class="photo-lightbox-caption"></p>
          
          <div class="photo-lightbox-actions">
            <a
              id="lightbox-download"
              class="lightbox-action-btn"
              href="#"
              target="_blank"
              download
              title="Scarica foto sul dispositivo"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span>Scarica</span>
            </a>

            <button
              id="lightbox-share"
              class="lightbox-action-btn"
              type="button"
              title="Condividi foto"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"/>
                <circle cx="6" cy="12" r="3"/>
                <circle cx="18" cy="19" r="3"/>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
              </svg>
              <span>Condividi</span>
            </button>
          </div>
        </div>
      </div>
    </dialog>

    <script type="module">
      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
      const MAX_FILES = 20;
      const MAX_FILE_SIZE = 10 * 1024 * 1024;
      const BATCH_SIZE = 24;

      const cameraInput = document.getElementById("camera-input");
      const galleryInput = document.getElementById("gallery-input");
      const uploadBtn = document.getElementById("upload-btn");
      const uploadLabel = document.getElementById("upload-label");
      const uploadSub = document.getElementById("upload-sub");
      const uploadCount = document.getElementById("upload-count");
      const loadMoreBtn = document.getElementById("load-more-btn");
      const gallery = document.getElementById("gallery-grid");
      const message = document.getElementById("message");
      const photoCount = document.getElementById("photo-count");
      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxCaption = document.getElementById("lightbox-caption");
      const lightboxClose = document.getElementById("lightbox-close");
      const lightboxPrev = document.getElementById("lightbox-prev");
      const lightboxNext = document.getElementById("lightbox-next");
      const lightboxDownload = document.getElementById("lightbox-download");
      const lightboxShare = document.getElementById("lightbox-share");

      let selectedFiles = [];
      let isUploading = false;
      let isLoadingMore = false;
      let allPhotos = [];
      let renderedCount = 0;
      let currentPhotoIndex = -1;

      function showMessage(text = "", isError = false) {
        message.textContent = text;
        message.dataset.error = isError ? "true" : "false";
        message.hidden = !text;
      }

      function setUploadingState(nextUploading) {
        isUploading = nextUploading;
        cameraInput.disabled = nextUploading;
        galleryInput.disabled = nextUploading;
        uploadBtn.disabled = nextUploading || !selectedFiles.length;
      }

      function updateSelectedFilesUI() {
        const count = selectedFiles.length;

        if (!count) {
          uploadLabel.textContent = "Invia foto";
          uploadSub.textContent = "Seleziona prima";
          uploadCount.hidden = true;
          uploadBtn.disabled = true;
          uploadBtn.dataset.hasFiles = "false";
          return;
        }

        uploadSub.textContent =
          count === 1 ? "1 selezionata" : `${count} selezionate`;
        uploadCount.textContent = String(count);
        uploadCount.hidden = false;
        uploadBtn.dataset.hasFiles = "true";
        uploadBtn.disabled = isUploading;
      }

      function normalizeFiles(fileList) {
        return Array.from(fileList || []).filter(
          (file) =>
            file.type.startsWith("image/") && file.size <= MAX_FILE_SIZE,
        );
      }

      function addFiles(fileList) {
        const validFiles = normalizeFiles(fileList);

        if (!validFiles.length) {
          showMessage("Seleziona immagini valide fino a 10 MB.", true);
          return;
        }

        selectedFiles = [...selectedFiles, ...validFiles].slice(0, MAX_FILES);
        updateSelectedFilesUI();
        showMessage("");
      }

      function getPhotoTimestamp(photo) {
        if (!photo?.uploaded) return 0;
        const value = new Date(photo.uploaded).getTime();
        return Number.isNaN(value) ? 0 : value;
      }

      function formatUploadedLabel(uploaded) {
        const date = uploaded ? new Date(uploaded) : null;
        return date && !Number.isNaN(date.getTime())
          ? date.toLocaleString("it-IT", {
              dateStyle: "short",
              timeStyle: "short",
            })
          : "Appena caricata";
      }

      function openLightbox(url, caption = "", index = -1) {
        currentPhotoIndex = index;
        lightboxImage.src = url;
        lightboxCaption.textContent = caption;

        if (lightboxDownload) {
          lightboxDownload.href = url;
        }

        if (lightboxPrev) {
          lightboxPrev.style.display = index > 0 ? "flex" : "none";
        }
        if (lightboxNext) {
          lightboxNext.style.display =
            index >= 0 && index < allPhotos.length - 1 ? "flex" : "none";
        }

        if (!lightbox.open) lightbox.showModal();
      }

      function closeLightbox() {
        if (lightbox.open) lightbox.close();
        lightboxImage.src = "";
        lightboxCaption.textContent = "";
        currentPhotoIndex = -1;
      }

      function navigateLightbox(direction) {
        if (currentPhotoIndex < 0 || !allPhotos.length) return;
        const targetIndex = currentPhotoIndex + direction;
        if (targetIndex >= 0 && targetIndex < allPhotos.length) {
          const photo = allPhotos[targetIndex];
          const uploadedLabel = formatUploadedLabel(photo.uploaded);
          openLightbox(photo.url, uploadedLabel, targetIndex);
        }
      }

      async function sharePhoto() {
        if (!lightboxImage.src) return;
        const photoUrl = lightboxImage.src;
        const shareData = {
          title: "Foto Matrimonio Anna & Stefano",
          text: "Guarda questa foto del matrimonio di Anna & Stefano!",
          url: photoUrl,
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (err) {
            // Condivisione annullata
          }
        } else {
          try {
            await navigator.clipboard.writeText(photoUrl);
            showMessage("Link della foto copiato negli appunti!", false);
            setTimeout(() => showMessage(""), 3500);
          } catch {
            showMessage("Impossibile condividere automaticamente", true);
          }
        }
      }

      function createPhotoCard(photo, index) {
        const card = document.createElement("article");
        card.className = "gallery-item";
        card.dataset.timestamp = String(getPhotoTimestamp(photo));

        const button = document.createElement("button");
        button.type = "button";
        button.className = "gallery-item-button";

        const uploadedLabel = formatUploadedLabel(photo.uploaded);
        button.setAttribute(
          "aria-label",
          `Apri foto ${index + 1}, caricata ${uploadedLabel}`,
        );
        button.addEventListener("click", () =>
          openLightbox(photo.url, uploadedLabel, index),
        );

        const imageWrap = document.createElement("div");
        imageWrap.className = "gallery-image-wrap";

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = `Foto caricata ${uploadedLabel}`;
        img.loading = "lazy";
        img.decoding = "async";
        img.setAttribute("fetchpriority", "low");
        img.addEventListener("load", () => img.classList.add("loaded"));

        imageWrap.appendChild(img);
        button.appendChild(imageWrap);
        card.appendChild(button);
        return card;
      }

      function updatePhotoCount() {
        photoCount.textContent = String(allPhotos.length);
      }

      function updateLoadMoreVisibility() {
        const isFinished = renderedCount >= allPhotos.length;
        loadMoreBtn.hidden = isFinished;
        if (!isFinished) {
          loadMoreBtn.textContent = `Carica altre foto (${renderedCount} di ${allPhotos.length})`;
        }
      }

      function appendNextBatch() {
        if (isLoadingMore) return;
        if (renderedCount >= allPhotos.length) {
          updateLoadMoreVisibility();
          return;
        }

        isLoadingMore = true;
        loadMoreBtn.disabled = true;

        const nextChunk = allPhotos.slice(
          renderedCount,
          renderedCount + BATCH_SIZE,
        );
        const fragment = document.createDocumentFragment();

        nextChunk.forEach((photo, index) => {
          fragment.appendChild(createPhotoCard(photo, renderedCount + index));
        });

        requestAnimationFrame(() => {
          gallery.appendChild(fragment);
          renderedCount += nextChunk.length;
          updateLoadMoreVisibility();
          isLoadingMore = false;
          loadMoreBtn.disabled = false;
        });
      }

      function resetFeed() {
        gallery.innerHTML = "";
        renderedCount = 0;
        appendNextBatch();
      }

      async function fetchAllPhotos() {
        const response = await fetch(`${workerBase}/photos`, {
          cache: "no-store",
        });
        if (!response.ok) throw new Error("Errore nel caricamento galleria");
        const data = await response.json();
        return Array.isArray(data) ? data : [];
      }

      async function loadInitialPhotos() {
        try {
          showMessage("");
          allPhotos = await fetchAllPhotos();
          updatePhotoCount();

          if (!allPhotos.length) {
            gallery.innerHTML = `
              <div class="empty-gallery-state">
                <svg class="empty-icon" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <p class="empty-title">Ancora nessuna foto</p>
                <p class="empty-sub">Condividi per primo un ricordo speciale di questa giornata!</p>
              </div>
            `;
            loadMoreBtn.hidden = true;
            return;
          }

          resetFeed();
        } catch {
          showMessage("Non riesco a caricare la galleria.", true);
        }
      }

      function setupInfiniteScroll() {
        if (!("IntersectionObserver" in window)) return;
        const observer = new IntersectionObserver(
          (entries) => {
            if (
              entries[0].isIntersecting &&
              !isLoadingMore &&
              renderedCount < allPhotos.length &&
              document.visibilityState === "visible"
            ) {
              appendNextBatch();
            }
          },
          { rootMargin: "400px" },
        );
        observer.observe(loadMoreBtn);
      }

      async function uploadFiles() {
        if (!selectedFiles.length || isUploading) return;

        setUploadingState(true);
        uploadSub.textContent = "Invio in corso...";
        uploadCount.hidden = true;
        showMessage("Sto inviando le foto...");

        try {
          const fd = new FormData();
          selectedFiles.forEach((file) => fd.append("photos", file));

          const res = await fetch(`${workerBase}/upload`, {
            method: "POST",
            body: fd,
          });

          let data;
          try {
            data = await res.json();
          } catch {
            throw new Error("Risposta server non valida");
          }

          if (!res.ok || data?.error) {
            throw new Error(data?.error || "Upload fallito");
          }

          selectedFiles = [];
          cameraInput.value = "";
          galleryInput.value = "";
          updateSelectedFilesUI();
          await loadInitialPhotos();
          showMessage("Foto inviate correttamente.", false);
        } catch {
          showMessage("Invio non riuscito. Riprova.", true);
          updateSelectedFilesUI();
        } finally {
          setUploadingState(false);
        }
      }

      cameraInput?.addEventListener("change", (event) =>
        addFiles(event.target.files),
      );
      galleryInput?.addEventListener("change", (event) =>
        addFiles(event.target.files),
      );
      uploadBtn?.addEventListener("click", uploadFiles);
      loadMoreBtn?.addEventListener("click", appendNextBatch);
      lightboxClose?.addEventListener("click", closeLightbox);
      lightboxPrev?.addEventListener("click", () => navigateLightbox(-1));
      lightboxNext?.addEventListener("click", () => navigateLightbox(1));
      lightboxShare?.addEventListener("click", sharePhoto);

      window.addEventListener("keydown", (event) => {
        if (!lightbox?.open) return;
        if (event.key === "ArrowLeft") navigateLightbox(-1);
        if (event.key === "ArrowRight") navigateLightbox(1);
      });

      // Swipe per Smartphone
      let touchStartX = 0;
      let touchEndX = 0;
      lightbox?.addEventListener(
        "touchstart",
        (e) => {
          touchStartX = e.changedTouches[0].screenX;
        },
        { passive: true },
      );

      lightbox?.addEventListener(
        "touchend",
        (e) => {
          touchEndX = e.changedTouches[0].screenX;
          const diffX = touchEndX - touchStartX;
          if (Math.abs(diffX) > 45) {
            if (diffX < 0) navigateLightbox(1);
            else navigateLightbox(-1);
          }
        },
        { passive: true },
      );

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      lightbox?.addEventListener("cancel", () => closeLightbox());
      lightbox?.addEventListener("close", () => closeLightbox());

      updateSelectedFilesUI();
      await loadInitialPhotos();
      setupInfiniteScroll();
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    background-color: var(--color-background);
    color: var(--color-text-dark, #1e1915);
    scroll-behavior: smooth;
  }

  body {
    font-family:
      "Montserrat",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  .photo-footer-wrap {
    padding-bottom: 115px;
  }

  /* SFONDO COORDINATO CON LA HOME */
  .photo-page {
    min-height: 100vh;
    padding: 0 0 140px;
    background:
      radial-gradient(
        ellipse at 50% 0%,
        rgba(185, 216, 235, 0.35),
        transparent 65%
      ),
      linear-gradient(180deg, var(--color-background) 0%, var(--color-primary) 100%);
  }

  .gallery-shell {
    width: min(100%, 1020px);
    margin: 0 auto;
    padding: 0 16px;
  }

  /* TOPBAR & HEADER ARMONIOSO COORDINATO */
  .gallery-topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    padding-top: max(16px, env(safe-area-inset-top, 0px));
    padding-bottom: 14px;
    background: color-mix(in srgb, var(--color-background) 90%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-muted), transparent 60%);
    transition: background 0.3s ease;
  }

  .gallery-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 4px 8px 4px 4px;
    padding-right: 64px; /* Spazio per non sovrapporsi al tasto menu hamburger */
  }

  .brand-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .gallery-subtitle {
    font-family: "Burgues Script", cursive, serif;
    font-size: clamp(26px, 4vw, 34px);
    font-style: normal;
    letter-spacing: 0.01em;
    color: var(--color-secondary);
    text-transform: none;
    line-height: 1.05;
    margin-bottom: -2px;
  }

  .gallery-title {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(20px, 3.2vw, 26px);
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.1;
    color: var(--color-secondary);
  }

  .gallery-tools {
    display: inline-flex;
    align-items: center;
  }

  .gallery-count-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    height: 40px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 70%, white 30%);
    border: 1px solid color-mix(in srgb, var(--color-muted), transparent 40%);
    box-shadow: 0 2px 10px rgba(30, 25, 21, 0.03);
    color: var(--color-secondary);
    font-size: 13px;
    font-weight: 700;
  }

  .count-icon {
    width: 17px;
    height: 17px;
    color: var(--color-secondary);
  }

  .gallery-message {
    margin: 12px 4px 16px;
    padding: 12px 18px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.05);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-secondary);
  }

  .gallery-message:empty,
  .gallery-message[hidden] {
    display: none;
  }

  .gallery-message[data-error="true"] {
    background: #fdf2f2;
    border-color: #f8b4b4;
    color: #9b1c1c;
  }

  /* GALLERY GRID OTTIMIZZATA PER FLUIDITÀ */
  .gallery-grid-wrap {
    border-radius: 22px;
    padding: 14px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
