<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Foto matrimonio</title>
  </head>
  <body>
    <main class="photo-page font-montserrat">
      <div class="app-shell">
        <section class="gallery-panel" aria-label="I vostri scatti">
          <div class="gallery-header-shell">
            <div class="gallery-header">
              <p class="gallery-title">I vostri scatti</p>

              <div class="gallery-tools">
                <span id="new-badge" class="gallery-new-badge" hidden>Nuovi scatti</span>
                <span id="photo-count" class="gallery-count" aria-label="Numero totale foto">0</span>
                <button id="refresh-btn" class="gallery-refresh" type="button" aria-label="Aggiorna galleria" title="Aggiorna galleria">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                    <path d="M21 3v6h-6" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <p id="message" class="gallery-message" role="status" aria-live="polite"></p>
          <div id="gallery-grid" class="gallery-grid"></div>

          <div class="gallery-footer">
            <button id="load-more-btn" class="load-more-btn" type="button" hidden>Carica altre foto</button>
            <div id="feed-sentinel" class="feed-sentinel" aria-hidden="true"></div>
          </div>
        </section>
      </div>

      <div class="upload-dock-wrap">
        <section class="upload-dock" aria-label="Azioni caricamento foto">
          <input id="camera-input" class="sr-only" type="file" accept="image/*" capture="environment" />
          <input id="gallery-input" class="sr-only" type="file" accept="image/*" multiple />

          <label for="camera-input" class="dock-action dock-action-secondary">
            <span class="dock-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M4 7h3l1.5-2h7L17 7h3v11H4z" />
                <circle cx="12" cy="13" r="4" />
              </svg>
            </span>
            <span class="dock-copy">
              <span class="dock-label">Foto</span>
              <span class="dock-sub">Scatta</span>
            </span>
          </label>

          <label for="gallery-input" class="dock-action dock-action-secondary">
            <span class="dock-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="4" y="5" width="16" height="14" rx="3" />
                <path d="M8 14l2.5-2.5 2.5 2.5 3.5-4 3.5 4.5" />
                <circle cx="9" cy="9" r="1.2" />
              </svg>
            </span>
            <span class="dock-copy">
              <span class="dock-label">Galleria</span>
              <span class="dock-sub">Scegli</span>
            </span>
          </label>

          <button id="upload-btn" class="dock-action dock-action-primary" type="button" disabled>
            <span class="dock-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M12 16V6" />
                <path d="M8.5 9.5 12 6l3.5 3.5" />
                <path d="M5 18.5h14" />
              </svg>
            </span>
            <span class="dock-copy dock-copy-primary">
              <span id="upload-label" class="dock-label dock-label-strong">Invia foto</span>
              <span id="upload-sub" class="dock-sub dock-sub-primary">Seleziona prima</span>
            </span>
            <span id="upload-count" class="dock-badge" hidden>0</span>
          </button>
        </section>
      </div>
    </main>

    <dialog id="lightbox" class="photo-lightbox" aria-label="Foto ingrandita">
      <div class="photo-lightbox-inner">
        <button id="lightbox-close" class="photo-lightbox-close" type="button" aria-label="Chiudi immagine">Chiudi</button>
        <img id="lightbox-image" class="photo-lightbox-image" alt="Foto ingrandita" />
        <p id="lightbox-caption" class="photo-lightbox-caption"></p>
      </div>
    </dialog>

    <script type="module">
      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
      const MAX_FILES = 20;
      const MAX_FILE_SIZE = 10 * 1024 * 1024;
      const BATCH_SIZE = 24;
      const MAX_RENDERED_ITEMS = 180;
      const AUTO_REFRESH_MS = 10 * 60 * 1000;

      const cameraInput = document.getElementById("camera-input");
      const galleryInput = document.getElementById("gallery-input");
      const uploadBtn = document.getElementById("upload-btn");
      const uploadLabel = document.getElementById("upload-label");
      const uploadSub = document.getElementById("upload-sub");
      const uploadCount = document.getElementById("upload-count");
      const refreshBtn = document.getElementById("refresh-btn");
      const loadMoreBtn = document.getElementById("load-more-btn");
      const newBadge = document.getElementById("new-badge");
      const gallery = document.getElementById("gallery-grid");
      const sentinel = document.getElementById("feed-sentinel");
      const message = document.getElementById("message");
      const photoCount = document.getElementById("photo-count");
      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxCaption = document.getElementById("lightbox-caption");
      const lightboxClose = document.getElementById("lightbox-close");

      let selectedFiles = [];
      let isUploading = false;
      let isLoadingMore = false;
      let isRefreshing = false;
      let allPhotos = [];
      let renderedCount = 0;
      let newestTimestamp = null;
      let autoRefreshTimer = null;
      let observer = null;

      function showMessage(text = "", isError = false) {
        message.textContent = text;
        message.dataset.error = isError ? "true" : "false";
        message.hidden = !text;
      }

      function setUploadingState(nextUploading) {
        isUploading = nextUploading;
        cameraInput.disabled = nextUploading;
        galleryInput.disabled = nextUploading;
        refreshBtn.disabled = nextUploading || isRefreshing;
        uploadBtn.disabled = nextUploading || !selectedFiles.length;
      }

      function updateSelectedFilesUI() {
        const count = selectedFiles.length;

        if (!count) {
          uploadLabel.textContent = "Invia foto";
          uploadSub.textContent = "Seleziona prima";
          uploadCount.hidden = true;
          uploadBtn.disabled = true;
          uploadBtn.dataset.hasFiles = "false";
          return;
        }

        uploadSub.textContent = count === 1 ? "1 selezionata" : `${count} selezionate`;
        uploadCount.textContent = String(count);
        uploadCount.hidden = false;
        uploadBtn.dataset.hasFiles = "true";
        uploadBtn.disabled = isUploading;
      }

      function normalizeFiles(fileList) {
        return Array.from(fileList || []).filter((file) => file.type.startsWith("image/") && file.size <= MAX_FILE_SIZE);
      }

      function addFiles(fileList) {
        const validFiles = normalizeFiles(fileList);

        if (!validFiles.length) {
          showMessage("Seleziona immagini valide fino a 10 MB.", true);
          return;
        }

        selectedFiles = [...selectedFiles, ...validFiles].slice(0, MAX_FILES);
        updateSelectedFilesUI();
        showMessage("");
      }

      function getPhotoTimestamp(photo) {
        if (!photo?.uploaded) return 0;
        const value = new Date(photo.uploaded).getTime();
        return Number.isNaN(value) ? 0 : value;
      }

      function formatUploadedLabel(uploaded) {
        const date = uploaded ? new Date(uploaded) : null;
        return date && !Number.isNaN(date.getTime())
          ? date.toLocaleString("it-IT", { dateStyle: "short", timeStyle: "short" })
          : "Appena caricata";
      }

      function openLightbox(url, caption = "") {
        lightboxImage.src = url;
        lightboxCaption.textContent = caption;
        if (!lightbox.open) lightbox.showModal();
      }

      function closeLightbox() {
        if (lightbox.open) lightbox.close();
      }

      function createPhotoCard(photo, index) {
        const card = document.createElement("article");
        card.className = "gallery-item";
        card.dataset.timestamp = String(getPhotoTimestamp(photo));

        const button = document.createElement("button");
        button.type = "button";
        button.className = "gallery-item-button";

        const uploadedLabel = formatUploadedLabel(photo.uploaded);
        button.setAttribute("aria-label", `Apri foto ${index + 1}, caricata ${uploadedLabel}`);
        button.addEventListener("click", () => openLightbox(photo.url, uploadedLabel));

        const imageWrap = document.createElement("div");
        imageWrap.className = "gallery-image-wrap";

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = `Foto caricata ${uploadedLabel}`;
        img.loading = "lazy";
        img.decoding = "async";

        imageWrap.appendChild(img);
        button.appendChild(imageWrap);
        card.appendChild(button);
        return card;
      }

      function updatePhotoCount() {
        photoCount.textContent = String(allPhotos.length);
      }

      function updateLoadMoreVisibility() {
        const hasMore = renderedCount < allPhotos.length;
        loadMoreBtn.hidden = !hasMore;
      }

      function trimRenderedItems() {
        const items = gallery.querySelectorAll(".gallery-item");
        if (items.length <= MAX_RENDERED_ITEMS) return;

        const toRemove = items.length - MAX_RENDERED_ITEMS;
        for (let i = 0; i < toRemove; i += 1) {
          const item = items[i];
          if (item) item.remove();
        }
      }

      function appendNextBatch() {
        if (isLoadingMore) return;
        if (renderedCount >= allPhotos.length) {
          updateLoadMoreVisibility();
          return;
        }

        isLoadingMore = true;
        const nextChunk = allPhotos.slice(renderedCount, renderedCount + BATCH_SIZE);
        const fragment = document.createDocumentFragment();

        nextChunk.forEach((photo, index) => {
          fragment.appendChild(createPhotoCard(photo, renderedCount + index));
        });

        gallery.appendChild(fragment);
        renderedCount += nextChunk.length;
        trimRenderedItems();
        updateLoadMoreVisibility();
        isLoadingMore = false;
      }

      function prependNewPhotos(photos) {
        if (!photos.length) return;

        const fragment = document.createDocumentFragment();
        photos.forEach((photo, index) => {
          fragment.appendChild(createPhotoCard(photo, index));
        });

        gallery.prepend(fragment);
        trimRenderedItems();
      }

      function resetFeed() {
        gallery.innerHTML = "";
        renderedCount = 0;
        appendNextBatch();
      }

      async function fetchAllPhotos() {
        const response = await fetch(`${workerBase}/photos`, { cache: "no-store" });
        if (!response.ok) throw new Error("Errore nel caricamento galleria");
        const data = await response.json();
        return Array.isArray(data) ? data : [];
      }

      async function loadInitialPhotos() {
        try {
          showMessage("");
          allPhotos = await fetchAllPhotos();
          newestTimestamp = allPhotos.length ? getPhotoTimestamp(allPhotos[0]) : null;
          updatePhotoCount();

          if (!allPhotos.length) {
            gallery.innerHTML = "";
            loadMoreBtn.hidden = true;
            showMessage("La galleria è ancora vuota.", false);
            return;
          }

          resetFeed();
          showMessage("");
        } catch {
          showMessage("Non riesco a caricare la galleria.", true);
          loadMoreBtn.hidden = false;
        }
      }

      async function refreshOnlyNewPhotos({ silent = false } = {}) {
        if (isRefreshing) return;
        isRefreshing = true;
        refreshBtn.disabled = true;

        try {
          const freshPhotos = await fetchAllPhotos();
          if (!Array.isArray(freshPhotos) || !freshPhotos.length) {
            isRefreshing = false;
            refreshBtn.disabled = false;
            return;
          }

          const latestKnown = newestTimestamp ?? 0;
          const newItems = freshPhotos.filter((photo) => getPhotoTimestamp(photo) > latestKnown);

          allPhotos = freshPhotos;
          newestTimestamp = getPhotoTimestamp(freshPhotos[0]);
          updatePhotoCount();
          updateLoadMoreVisibility();

          if (newItems.length) {
            prependNewPhotos(newItems);
            renderedCount = Math.min(allPhotos.length, renderedCount + newItems.length);
            newBadge.hidden = false;
            newBadge.textContent = newItems.length === 1 ? "1 nuovo scatto" : `${newItems.length} nuovi scatti`;

            if (!silent) {
              showMessage(newItems.length === 1 ? "È arrivato un nuovo scatto." : `Sono arrivati ${newItems.length} nuovi scatti.`, false);
            }

            window.setTimeout(() => {
              newBadge.hidden = true;
            }, 5000);
          } else if (!silent) {
            showMessage("Nessuna nuova foto al momento.", false);
          }
        } catch {
          if (!silent) {
            showMessage("Non riesco ad aggiornare la galleria.", true);
          }
          loadMoreBtn.hidden = false;
        } finally {
          isRefreshing = false;
          refreshBtn.disabled = isUploading;
        }
      }

      function startAutoRefresh() {
        if (autoRefreshTimer) window.clearInterval(autoRefreshTimer);
        autoRefreshTimer = window.setInterval(() => {
          refreshOnlyNewPhotos({ silent: true });
        }, AUTO_REFRESH_MS);
      }

      function setupInfiniteScroll() {
        if (observer) observer.disconnect();

        observer = new IntersectionObserver((entries) => {
          const entry = entries[0];
          if (!entry?.isIntersecting) return;
          appendNextBatch();
        }, {
          root: null,
          rootMargin: "800px 0px 800px 0px",
          threshold: 0
        });

        observer.observe(sentinel);
      }

      async function uploadFiles() {
        if (!selectedFiles.length || isUploading) return;

        setUploadingState(true);
        uploadSub.textContent = "Invio in corso...";
        uploadCount.hidden = true;
        showMessage("Sto inviando le foto...");

        try {
          const fd = new FormData();
          selectedFiles.forEach((file) => fd.append("photos", file));

          const res = await fetch(`${workerBase}/upload`, {
            method: "POST",
            body: fd
          });

          let data;
          try {
            data = await res.json();
          } catch {
            throw new Error("Risposta server non valida");
          }

          if (!res.ok || data?.error) {
            throw new Error(data?.error || "Upload fallito");
          }

          selectedFiles = [];
          cameraInput.value = "";
          galleryInput.value = "";
          updateSelectedFilesUI();
          await refreshOnlyNewPhotos({ silent: false });
          showMessage("Foto inviate correttamente.", false);
        } catch {
          showMessage("Invio non riuscito. Riprova.", true);
          updateSelectedFilesUI();
        } finally {
          setUploadingState(false);
        }
      }

      cameraInput?.addEventListener("change", (event) => addFiles(event.target.files));
      galleryInput?.addEventListener("change", (event) => addFiles(event.target.files));
      uploadBtn?.addEventListener("click", uploadFiles);
      refreshBtn?.addEventListener("click", () => refreshOnlyNewPhotos({ silent: false }));
      loadMoreBtn?.addEventListener("click", appendNextBatch);
      lightboxClose?.addEventListener("click", closeLightbox);

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      lightbox?.addEventListener("cancel", () => {
        lightboxImage.src = "";
        lightboxCaption.textContent = "";
      });

      lightbox?.addEventListener("close", () => {
        lightboxImage.src = "";
        lightboxCaption.textContent = "";
      });

      updateSelectedFilesUI();
      await loadInitialPhotos();
      setupInfiniteScroll();
      startAutoRefresh();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --sand-1: #f5f0e8;
    --sand-2: #ece2d3;
    --sand-3: #dbcdb7;
    --blue-1: #edf5f7;
    --blue-2: #dbeaf0;
    --blue-3: #b9d2dc;
    --blue-4: #86aebf;
    --blue-5: #6b97ab;
    --ink: #221b18;
    --ink-soft: rgba(34, 27, 24, 0.68);
    --white: rgba(255, 255, 255, 0.96);
  }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--blue-1);
  }

  body {
    font-family: Montserrat, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  .photo-page {
    min-height: 100vh;
    padding: 10px 10px 128px;
    background:
      radial-gradient(circle at top left, rgba(185, 210, 220, 0.5), transparent 36%),
      linear-gradient(180deg, var(--blue-2) 0%, #eef4f5 44%, var(--sand-1) 100%);
  }

  .app-shell {
    width: min(100%, 980px);
    margin: 0 auto;
  }

  .gallery-panel {
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.94);
    box-shadow: 0 18px 40px rgba(107, 151, 171, 0.12);
    backdrop-filter: blur(16px);
    overflow: visible;
    padding: 0 12px 14px;
  }

  .gallery-header-shell {
    position: sticky;
    top: 0;
    z-index: 12;
    margin: 0 -12px;
    padding: 12px 12px 10px;
    backdrop-filter: blur(18px);
    background: linear-gradient(180deg, rgba(245, 240, 232, 0.92) 0%, rgba(237, 245, 247, 0.88) 100%);
    border-bottom: 1px solid rgba(134, 174, 191, 0.16);
  }

  .gallery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .gallery-title {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(34, 27, 24, 0.82);
  }

  .gallery-tools {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .gallery-new-badge,
  .gallery-count,
  .gallery-refresh,
  .load-more-btn {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gallery-new-badge {
    padding: 0 12px;
    background: rgba(134, 174, 191, 0.18);
    color: #3a6578;
    border: 1px solid rgba(134, 174, 191, 0.24);
  }

  .gallery-count,
  .gallery-refresh,
  .load-more-btn {
    border: 1px solid rgba(107, 151, 171, 0.12);
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    box-shadow: 0 4px 12px rgba(107, 151, 171, 0.08);
  }

  .gallery-count,
  .gallery-refresh {
    min-width: 36px;
    padding: 0 12px;
  }

  .gallery-refresh,
  .gallery-item-button,
  .photo-lightbox-close,
  .dock-action,
  .load-more-btn {
    cursor: pointer;
  }

  .gallery-refresh svg,
  .dock-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gallery-message {
    margin: 12px 2px 10px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .gallery-message:empty,
  .gallery-message[hidden] {
    display: none;
  }

  .gallery-message[data-error="true"] {
    color: #a04242;
  }

  .gallery-grid {
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    margin: 0 -12px;
    background: rgba(185, 210, 220, 0.16);
  }

  .gallery-item {
    overflow: hidden;
    min-width: 0;
    background: #dfe8ec;
  }

  .gallery-item-button {
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    display: block;
  }

  .gallery-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: linear-gradient(180deg, var(--blue-2) 0%, var(--sand-2) 100%);
  }

  .gallery-image-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 200ms ease;
  }

  .gallery-item-button:hover .gallery-image-wrap img,
  .gallery-item-button:focus-visible .gallery-image-wrap img {
    transform: scale(1.04);
  }

  .gallery-footer {
    padding: 14px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .load-more-btn {
    padding: 0 18px;
    background: linear-gradient(180deg, var(--sand-1) 0%, var(--sand-2) 100%);
    border-color: rgba(134, 174, 191, 0.18);
    color: #5d5349;
  }

  .feed-sentinel {
    width: 100%;
    height: 2px;
  }

  .upload-dock-wrap {
    position: fixed;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 10px);
    transform: translateX(-50%);
    width: min(calc(100% - 20px), 760px);
    z-index: 40;
  }

  .upload-dock {
    display: grid;
    grid-template-columns: 1fr 1fr 1.15fr;
    gap: 10px;
    padding: 10px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.96);
    box-shadow: 0 18px 38px rgba(107, 151, 171, 0.2);
    backdrop-filter: blur(22px);
  }

  .dock-action {
    appearance: none;
    border: 0;
    min-height: 74px;
    padding: 10px 14px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
    position: relative;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .dock-action:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .dock-action-secondary {
    background: linear-gradient(180deg, var(--blue-1) 0%, rgba(244, 239, 232, 0.96) 100%);
    box-shadow:
      inset 0 0 0 1px rgba(107, 151, 171, 0.08),
      0 10px 20px rgba(107, 151, 171, 0.08);
  }

  .dock-action-primary {
    background: linear-gradient(180deg, #84afc0 0%, #6b97ab 100%);
    color: #ffffff;
    box-shadow: 0 14px 24px rgba(107, 151, 171, 0.28);
  }

  .dock-action:disabled {
    opacity: 0.58;
    cursor: not-allowed;
    transform: none;
  }

  .dock-action-primary[data-has-files="true"] {
    box-shadow: 0 14px 28px rgba(107, 151, 171, 0.32), 0 0 0 3px rgba(185, 210, 220, 0.34);
  }

  .dock-icon {
    width: 42px;
    height: 42px;
    border-radius: 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(107, 151, 171, 0.1);
    flex: 0 0 auto;
  }

  .dock-action-primary .dock-icon {
    background: rgba(255, 255, 255, 0.16);
  }

  .dock-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .dock-copy-primary {
    padding-right: 30px;
  }

  .dock-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .dock-label-strong {
    letter-spacing: 0.05em;
  }

  .dock-sub {
    margin-top: 4px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(34, 27, 24, 0.48);
    line-height: 1.1;
  }

  .dock-sub-primary {
    color: rgba(255, 255, 255, 0.72);
  }

  .dock-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    min-width: 24px;
    height: 24px;
    padding: 0 7px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--sand-1);
    color: #5c5248;
    font-size: 11px;
