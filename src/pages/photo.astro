---
---
<section class="photo-page font-montserrat" data-photo-app>
  <div class="photo-shell">
    <div class="photo-panel photo-upload-panel">
      <div class="photo-intro">
        <p class="photo-kicker">Album condiviso</p>
        <h1 class="photo-title">Carica le tue foto del matrimonio</h1>
        <p class="photo-text">
          Scatta una foto oppure scegli immagini dal telefono, poi condividile nella galleria del matrimonio.
        </p>
      </div>

      <div class="photo-actions">
        <label for="camera-input" class="photo-btn photo-btn-primary">Scatta una foto</label>
        <label for="gallery-input" class="photo-btn">Scegli dalla galleria</label>
        <button id="upload-btn" class="photo-btn photo-btn-soft" type="button" disabled>Carica adesso</button>
      </div>

      <input id="camera-input" class="sr-only" type="file" accept="image/*" capture="environment" />
      <input id="gallery-input" class="sr-only" type="file" accept="image/*" multiple />

      <p id="selected-files" class="photo-selected">Nessuna foto selezionata.</p>

      <div class="photo-stats">
        <div class="photo-stat">
          <span>Stato upload</span>
          <strong id="upload-status">In attesa</strong>
        </div>
        <div class="photo-stat">
          <span>Foto visibili</span>
          <strong id="photo-count">0</strong>
        </div>
      </div>
    </div>

    <div class="photo-panel photo-gallery-panel">
      <div class="photo-gallery-head">
        <p class="photo-kicker photo-kicker-gallery">Galleria Live</p>
        <button id="refresh-btn" class="photo-refresh-icon" type="button" aria-label="Aggiorna galleria" title="Aggiorna galleria">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12a9 9 0 1 1-2.64-6.36" />
            <path d="M21 3v6h-6" />
          </svg>
        </button>
      </div>

      <p id="message" class="photo-message" role="status" aria-live="polite"></p>
      <div id="gallery-grid" class="photo-grid"></div>
    </div>
  </div>

  <dialog id="lightbox" class="photo-lightbox" aria-label="Foto ingrandita">
    <div class="photo-lightbox-inner">
      <button id="lightbox-close" class="photo-lightbox-close" type="button" aria-label="Chiudi immagine">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6L6 18" />
          <path d="M6 6l12 12" />
        </svg>
      </button>
      <img id="lightbox-image" class="photo-lightbox-image" alt="Foto ingrandita" />
      <p id="lightbox-caption" class="photo-lightbox-caption"></p>
    </div>
  </dialog>
</section>

<script type="module">
  const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
  const MAX_FILES = 20;
  const MAX_FILE_SIZE = 10 * 1024 * 1024;

  const cameraInput = document.getElementById("camera-input");
  const galleryInput = document.getElementById("gallery-input");
  const uploadBtn = document.getElementById("upload-btn");
  const refreshBtn = document.getElementById("refresh-btn");
  const selectedFilesText = document.getElementById("selected-files");
  const gallery = document.getElementById("gallery-grid");
  const message = document.getElementById("message");
  const uploadStatus = document.getElementById("upload-status");
  const photoCount = document.getElementById("photo-count");
  const lightbox = document.getElementById("lightbox");
  const lightboxImage = document.getElementById("lightbox-image");
  const lightboxCaption = document.getElementById("lightbox-caption");
  const lightboxClose = document.getElementById("lightbox-close");

  let selectedFiles = [];
  let isUploading = false;

  function showMessage(text = "", isError = false) {
    if (!message) return;
    message.textContent = text;
    message.dataset.error = isError ? "true" : "false";
    message.hidden = !text;
  }

  function setUploadingState(nextUploading) {
    isUploading = nextUploading;
    if (cameraInput) cameraInput.disabled = nextUploading;
    if (galleryInput) galleryInput.disabled = nextUploading;
    if (refreshBtn) refreshBtn.disabled = nextUploading;
    if (uploadBtn) uploadBtn.disabled = nextUploading || !selectedFiles.length;
    if (uploadStatus) uploadStatus.textContent = nextUploading ? "Caricamento..." : "In attesa";
  }

  function updateSelectedFilesUI() {
    if (!selectedFilesText || !uploadBtn) return;

    if (!selectedFiles.length) {
      selectedFilesText.textContent = "Nessuna foto selezionata.";
      uploadBtn.disabled = true;
      if (!isUploading && uploadStatus) uploadStatus.textContent = "In attesa";
      return;
    }

    const names = selectedFiles.slice(0, 3).map((file) => file.name).join(", ");
    const extra = selectedFiles.length > 3 ? ` +${selectedFiles.length - 3} altre` : "";
    selectedFilesText.textContent = `${selectedFiles.length} foto selezionate: ${names}${extra}`;
    uploadBtn.disabled = isUploading;
  }

  function normalizeFiles(fileList) {
    return Array.from(fileList || []).filter((file) => file.type.startsWith("image/") && file.size <= MAX_FILE_SIZE);
  }

  function addFiles(fileList) {
    const validFiles = normalizeFiles(fileList);

    if (!validFiles.length) {
      showMessage("Seleziona immagini valide fino a 10 MB.", true);
      return;
    }

    selectedFiles = [...selectedFiles, ...validFiles].slice(0, MAX_FILES);
    updateSelectedFilesUI();
    showMessage("");
  }

  function formatUploadedLabel(uploaded) {
    const date = uploaded ? new Date(uploaded) : null;
    return date && !Number.isNaN(date.getTime())
      ? date.toLocaleString("it-IT", { dateStyle: "short", timeStyle: "short" })
      : "Appena caricata";
  }

  function openLightbox(url, caption = "") {
    if (!lightbox || !lightboxImage || !lightboxCaption) return;
    lightboxImage.src = url;
    lightboxCaption.textContent = caption;
    if (!lightbox.open) lightbox.showModal();
  }

  function closeLightbox() {
    if (lightbox?.open) lightbox.close();
  }

  function createPhotoCard(photo, index) {
    const card = document.createElement("article");
    card.className = "photo-card";

    const button = document.createElement("button");
    button.type = "button";
    button.className = "photo-card-button";

    const uploadedLabel = formatUploadedLabel(photo.uploaded);
    button.setAttribute("aria-label", `Apri foto ${index + 1}, caricata ${uploadedLabel}`);
    button.addEventListener("click", () => openLightbox(photo.url, uploadedLabel));

    const media = document.createElement("div");
    media.className = "photo-media";

    const img = document.createElement("img");
    img.src = photo.url;
    img.alt = `Foto caricata ${uploadedLabel}`;
    img.loading = "lazy";
    img.decoding = "async";

    media.appendChild(img);
    button.appendChild(media);
    card.appendChild(button);
    return card;
  }

  async function loadPhotos() {
    try {
      showMessage("");
      const res = await fetch(`${workerBase}/photos`, { cache: "no-store" });
      if (!res.ok) throw new Error("Errore nel caricamento galleria");

      const photos = await res.json();
      if (!gallery || !photoCount) return;

      gallery.innerHTML = "";
      photoCount.textContent = String(photos.length);

      if (!photos.length) {
        showMessage("");
        return;
      }

      const frag = document.createDocumentFragment();
      photos.forEach((photo, index) => frag.appendChild(createPhotoCard(photo, index)));
      gallery.appendChild(frag);
      showMessage("");
    } catch {
      showMessage("Non riesco a caricare la galleria.", true);
    }
  }

  async function uploadFiles() {
    if (!selectedFiles.length || isUploading) return;

    setUploadingState(true);
    showMessage("Sto caricando le foto...");

    try {
      const fd = new FormData();
      selectedFiles.forEach((file) => fd.append("photos", file));

      const res = await fetch(`${workerBase}/upload`, {
        method: "POST",
        body: fd
      });

      let data;
      try {
        data = await res.json();
      } catch {
        throw new Error("Risposta server non valida");
      }

      if (!res.ok || data?.error) {
        throw new Error(data?.error || "Upload fallito");
      }

      selectedFiles = [];
      if (cameraInput) cameraInput.value = "";
      if (galleryInput) galleryInput.value = "";
      updateSelectedFilesUI();
      if (uploadStatus) uploadStatus.textContent = "Upload completato";
      showMessage("");
      await loadPhotos();
    } catch {
      if (uploadStatus) uploadStatus.textContent = "Errore upload";
      showMessage("Upload non riuscito. Riprova.", true);
    } finally {
      setUploadingState(false);
      updateSelectedFilesUI();
    }
  }

  cameraInput?.addEventListener("change", (event) => addFiles(event.target.files));
  galleryInput?.addEventListener("change", (event) => addFiles(event.target.files));
  uploadBtn?.addEventListener("click", uploadFiles);
  refreshBtn?.addEventListener("click", loadPhotos);
  lightboxClose?.addEventListener("click", closeLightbox);

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  lightbox?.addEventListener("cancel", () => {
    if (lightboxImage) lightboxImage.src = "";
    if (lightboxCaption) lightboxCaption.textContent = "";
  });

  lightbox?.addEventListener("close", () => {
    if (lightboxImage) lightboxImage.src = "";
    if (lightboxCaption) lightboxCaption.textContent = "";
  });

  updateSelectedFilesUI();
  loadPhotos();
</script>

<style>
  .photo-page {
    position: relative;
    min-height: 100vh;
    padding: 1rem 0.9rem 2.5rem;
    font-family: Montserrat, sans-serif;
    color: var(--color-text-dark, #f5efe6);
    background:
      linear-gradient(180deg, rgba(186, 210, 221, 0.7) 0%, rgba(206, 226, 234, 0.5) 22%, rgba(233, 236, 231, 0.18) 100%),
      radial-gradient(circle at top, rgba(226, 244, 255, 0.95) 0%, rgba(187, 214, 227, 0.45) 38%, rgba(142, 171, 186, 0.12) 74%, transparent 100%);
  }

  .photo-shell {
    width: min(100%, 72rem);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .photo-panel {
    border-radius: 1.8rem;
    padding: 1rem;
    background: rgba(141, 130, 124, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 14px 40px rgba(79, 95, 108, 0.12);
    overflow: hidden;
  }

  .photo-upload-panel {
    background:
      linear-gradient(180deg, rgba(219, 234, 240, 0.88) 0%, rgba(208, 227, 235, 0.78) 100%),
      rgba(205, 224, 232, 0.82);
    color: #231f1d;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .photo-gallery-panel {
    background: rgba(124, 114, 109, 0.72);
  }

  .photo-intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: center;
  }

  .photo-kicker {
    margin: 0;
    font-size: 0.68rem;
    line-height: 1;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .photo-kicker-gallery {
    color: rgba(244, 239, 233, 0.92);
  }

  .photo-title {
    margin: 0;
    text-transform: uppercase;
    line-height: 0.88;
    letter-spacing: -0.05em;
    font-size: clamp(2.5rem, 9vw, 5rem);
    color: #201917;
  }

  .photo-text,
  .photo-selected,
  .photo-message,
  .photo-lightbox-caption {
    margin: 0;
    line-height: 1.6;
    text-align: center;
  }

  .photo-text,
  .photo-selected,
  .photo-stat span,
  .photo-stat strong {
    color: rgba(35, 31, 29, 0.92);
  }

  .photo-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.35rem;
  }

  .photo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    width: 100%;
    padding: 0.95rem 1.3rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.1);
    color: rgba(47, 54, 57, 0.9);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.62rem;
    font-weight: 700;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease, opacity 180ms ease;
    cursor: pointer;
  }

  .photo-btn:hover,
  .photo-btn:focus-visible {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.78);
  }

  .photo-btn:active {
    transform: scale(0.98);
  }

  .photo-btn-primary {
    background: rgba(255, 255, 255, 0.2);
  }

  .photo-btn-soft:disabled {
    opacity: 0.42;
    cursor: not-allowed;
    transform: none;
  }

  .photo-selected {
    margin-top: 0.95rem;
    font-size: 0.94rem;
  }

  .photo-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .photo-stat {
    border-radius: 1.2rem;
    padding: 0.9rem 0.8rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.28);
    text-align: center;
  }

  .photo-stat span {
    display: block;
    font-size: 0.58rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .photo-stat strong {
    display: block;
    margin-top: 0.35rem;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .photo-gallery-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .photo-refresh-icon {
    flex: 0 0 auto;
    width: 2.65rem;
    height: 2.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(228, 242, 247, 0.68);
    background: linear-gradient(180deg, rgba(226, 245, 251, 0.95) 0%, rgba(183, 210, 220, 0.96) 100%);
    color: rgba(58, 74, 79, 0.95);
    box-shadow: 0 8px 18px rgba(34, 44, 49, 0.16);
    transition: transform 180ms ease, filter 180ms ease;
  }

  .photo-refresh-icon svg,
  .photo-lightbox-close svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .photo-refresh-icon:hover,
  .photo-refresh-icon:focus-visible,
  .photo-lightbox-close:hover,
  .photo-lightbox-close:focus-visible {
    filter: brightness(1.05);
  }

  .photo-refresh-icon:active,
  .photo-lightbox-close:active {
    transform: scale(0.97);
  }

  .photo-message {
    min-height: 1.2rem;
    margin-bottom: 0.4rem;
    color: rgba(244, 239, 233, 0.9);
    font-size: 0.88rem;
  }

  .photo-message:empty,
  .photo-message[hidden] {
    display: none;
  }

  .photo-message[data-error="true"] {
    color: #ffe1df;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    align-items: start;
  }

  .photo-card {
    width: 100%;
    min-width: 0;
    border-radius: 0;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
  }

  .photo-card-button {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .photo-media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: rgba(215, 215, 215, 0.22);
  }

  .photo-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .photo-lightbox {
    width: min(92vw, 960px);
    max-width: 960px;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .photo-lightbox::backdrop {
    background: rgba(12, 10, 9, 0.78);
    backdrop-filter: blur(4px);
  }

  .photo-lightbox-inner {
    position: relative;
  }

  .photo-lightbox-close {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 2;
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(34, 30, 28, 0.58);
    color: #fff;
  }

  .photo-lightbox-image {
    display: block;
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 1.3rem;
    background: rgba(11, 9, 8, 0.96);
  }

  .photo-lightbox-caption {
    margin-top: 0.7rem;
    color: rgba(244, 239, 233, 0.92);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 900px) {
    .photo-page {
      padding: 1.3rem 1.2rem 3rem;
    }

    .photo-panel {
      padding: 1.25rem;
    }

    .photo-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.7rem;
    }
  }
</style>