<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Foto matrimonio</title>
  </head>
  <body>
    <main class="photo-page font-montserrat">
      <div class="app-shell">
        <section class="app-hero">
          <div class="app-hero-top">
            <div>
              <p class="app-kicker">Album live</p>
              <h1 class="app-title">Galleria matrimonio</h1>
              <p class="app-subtitle">Tutte le foto in tempo reale, in uno stile più app e più semplice da usare.</p>
            </div>
            <div class="app-live-pill">
              <span class="app-live-dot"></span>
              <span>Live</span>
            </div>
          </div>

          <div class="gallery-card">
            <div class="gallery-card-head">
              <div>
                <p class="gallery-label">Galleria live</p>
                <p class="gallery-caption">Sfoglia le foto degli invitati pagina per pagina.</p>
              </div>

              <div class="gallery-tools">
                <span id="photo-count" class="gallery-count" aria-label="Numero totale foto">0</span>
                <button id="refresh-btn" class="gallery-refresh" type="button" aria-label="Aggiorna galleria" title="Aggiorna galleria">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                    <path d="M21 3v6h-6" />
                  </svg>
                </button>
              </div>
            </div>

            <p id="message" class="gallery-message" role="status" aria-live="polite"></p>
            <div id="gallery-grid" class="gallery-grid"></div>
            <div id="gallery-pagination" class="gallery-pagination" aria-label="Pagine galleria"></div>
          </div>
        </section>

        <section class="upload-panel">
          <div class="upload-panel-head">
            <div>
              <p class="app-kicker">Caricamento</p>
              <h2 class="upload-title">Aggiungi le tue foto</h2>
            </div>
            <p class="upload-copy">Tre azioni chiare: scatta, scegli, invia.</p>
          </div>

          <div class="upload-actions">
            <label for="camera-input" class="upload-action upload-action-dark">
              <span class="upload-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M4 7h3l1.5-2h7L17 7h3v11H4z" />
                  <circle cx="12" cy="13" r="4" />
                </svg>
              </span>
              <span class="upload-action-text">
                <strong>Foto</strong>
                <small>Scatta ora</small>
              </span>
            </label>

            <label for="gallery-input" class="upload-action">
              <span class="upload-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <rect x="4" y="5" width="16" height="14" rx="3" />
                  <path d="M8 14l2.5-2.5 2.5 2.5 3.5-4 3.5 4.5" />
                  <circle cx="9" cy="9" r="1.2" />
                </svg>
              </span>
              <span class="upload-action-text">
                <strong>Galleria</strong>
                <small>Scegli dal telefono</small>
              </span>
            </label>

            <button id="upload-btn" class="upload-action upload-action-accent" type="button" disabled>
              <span class="upload-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M12 16V6" />
                  <path d="M8.5 9.5 12 6l3.5 3.5" />
                  <path d="M5 18.5h14" />
                </svg>
              </span>
              <span class="upload-action-text">
                <strong>Invia foto</strong>
                <small>Carica nella gallery</small>
              </span>
            </button>
          </div>

          <input id="camera-input" class="sr-only" type="file" accept="image/*" capture="environment" />
          <input id="gallery-input" class="sr-only" type="file" accept="image/*" multiple />

          <div class="upload-status-card">
            <p class="upload-status-label">Selezione attuale</p>
            <p id="selected-files" class="upload-status-text">Nessuna foto selezionata.</p>
          </div>
        </section>
      </div>
    </main>

    <dialog id="lightbox" class="photo-lightbox" aria-label="Foto ingrandita">
      <div class="photo-lightbox-inner">
        <button id="lightbox-close" class="photo-lightbox-close" type="button" aria-label="Chiudi immagine">Chiudi</button>
        <img id="lightbox-image" class="photo-lightbox-image" alt="Foto ingrandita" />
        <p id="lightbox-caption" class="photo-lightbox-caption"></p>
      </div>
    </dialog>

    <script type="module">
      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
      const MAX_FILES = 20;
      const MAX_FILE_SIZE = 10 * 1024 * 1024;
      const PHOTOS_PER_PAGE = 18;

      const cameraInput = document.getElementById("camera-input");
      const galleryInput = document.getElementById("gallery-input");
      const uploadBtn = document.getElementById("upload-btn");
      const refreshBtn = document.getElementById("refresh-btn");
      const selectedFilesText = document.getElementById("selected-files");
      const gallery = document.getElementById("gallery-grid");
      const pagination = document.getElementById("gallery-pagination");
      const message = document.getElementById("message");
      const photoCount = document.getElementById("photo-count");
      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxCaption = document.getElementById("lightbox-caption");
      const lightboxClose = document.getElementById("lightbox-close");

      let selectedFiles = [];
      let isUploading = false;
      let allPhotos = [];
      let currentPage = 1;

      function showMessage(text = "", isError = false) {
        message.textContent = text;
        message.dataset.error = isError ? "true" : "false";
        message.hidden = !text;
      }

      function setUploadingState(nextUploading) {
        isUploading = nextUploading;
        cameraInput.disabled = nextUploading;
        galleryInput.disabled = nextUploading;
        refreshBtn.disabled = nextUploading;
        uploadBtn.disabled = nextUploading || !selectedFiles.length;
      }

      function updateSelectedFilesUI() {
        if (!selectedFiles.length) {
          selectedFilesText.textContent = "Nessuna foto selezionata. Tocca Foto o Galleria per iniziare.";
          uploadBtn.disabled = true;
          return;
        }

        const names = selectedFiles.slice(0, 2).map((file) => file.name).join(", ");
        const extra = selectedFiles.length > 2 ? ` +${selectedFiles.length - 2} altre` : "";
        selectedFilesText.textContent = `${selectedFiles.length} foto selezionate: ${names}${extra}`;
        uploadBtn.disabled = isUploading;
      }

      function normalizeFiles(fileList) {
        return Array.from(fileList || []).filter((file) => file.type.startsWith("image/") && file.size <= MAX_FILE_SIZE);
      }

      function addFiles(fileList) {
        const validFiles = normalizeFiles(fileList);

        if (!validFiles.length) {
          showMessage("Seleziona immagini valide fino a 10 MB.", true);
          return;
        }

        selectedFiles = [...selectedFiles, ...validFiles].slice(0, MAX_FILES);
        updateSelectedFilesUI();
        showMessage("");
      }

      function formatUploadedLabel(uploaded) {
        const date = uploaded ? new Date(uploaded) : null;
        return date && !Number.isNaN(date.getTime())
          ? date.toLocaleString("it-IT", { dateStyle: "short", timeStyle: "short" })
          : "Appena caricata";
      }

      function openLightbox(url, caption = "") {
        lightboxImage.src = url;
        lightboxCaption.textContent = caption;
        if (!lightbox.open) lightbox.showModal();
      }

      function closeLightbox() {
        if (lightbox.open) lightbox.close();
      }

      function createPhotoCard(photo, index) {
        const card = document.createElement("article");
        card.className = "gallery-item";

        const button = document.createElement("button");
        button.type = "button";
        button.className = "gallery-item-button";

        const uploadedLabel = formatUploadedLabel(photo.uploaded);
        button.setAttribute("aria-label", `Apri foto ${index + 1}, caricata ${uploadedLabel}`);
        button.addEventListener("click", () => openLightbox(photo.url, uploadedLabel));

        const imageWrap = document.createElement("div");
        imageWrap.className = "gallery-image-wrap";

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = `Foto caricata ${uploadedLabel}`;
        img.loading = "lazy";
        img.decoding = "async";

        const meta = document.createElement("div");
        meta.className = "gallery-item-meta";
        meta.textContent = uploadedLabel;

        imageWrap.appendChild(img);
        button.appendChild(imageWrap);
        card.appendChild(button);
        card.appendChild(meta);
        return card;
      }

      function renderPagination(totalPages) {
        pagination.innerHTML = "";

        if (totalPages <= 1) {
          pagination.hidden = true;
          return;
        }

        pagination.hidden = false;

        const pages = new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1]);

        const orderedPages = [...pages]
          .filter((page) => page >= 1 && page <= totalPages)
          .sort((a, b) => a - b);

        let lastPage = 0;

        orderedPages.forEach((page) => {
          if (page - lastPage > 1) {
            const dots = document.createElement("span");
            dots.className = "gallery-page-dots";
            dots.textContent = "...";
            dots.setAttribute("aria-hidden", "true");
            pagination.appendChild(dots);
          }

          const button = document.createElement("button");
          button.type = "button";
          button.className = "gallery-page-btn";
          button.textContent = String(page);
          button.setAttribute("aria-label", `Vai alla pagina ${page}`);

          if (page === currentPage) {
            button.dataset.active = "true";
            button.setAttribute("aria-current", "page");
          }

          button.addEventListener("click", () => {
            if (page === currentPage) return;
            currentPage = page;
            renderGallery();
          });

          pagination.appendChild(button);
          lastPage = page;
        });
      }

      function renderGallery() {
        gallery.innerHTML = "";

        if (!allPhotos.length) {
          pagination.hidden = true;
          return;
        }

        const totalPages = Math.max(1, Math.ceil(allPhotos.length / PHOTOS_PER_PAGE));
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * PHOTOS_PER_PAGE;
        const visiblePhotos = allPhotos.slice(start, start + PHOTOS_PER_PAGE);
        const frag = document.createDocumentFragment();

        visiblePhotos.forEach((photo, index) => {
          frag.appendChild(createPhotoCard(photo, start + index));
        });

        gallery.appendChild(frag);
        renderPagination(totalPages);
      }

      async function loadPhotos() {
        try {
          showMessage("");
          const res = await fetch(`${workerBase}/photos`, { cache: "no-store" });
          if (!res.ok) throw new Error("Errore nel caricamento galleria");

          allPhotos = await res.json();
          photoCount.textContent = String(allPhotos.length);

          if (!allPhotos.length) {
            gallery.innerHTML = "";
            pagination.hidden = true;
            showMessage("La galleria è ancora vuota.", false);
            return;
          }

          currentPage = 1;
          renderGallery();
          showMessage("");
        } catch {
          showMessage("Non riesco a caricare la galleria.", true);
        }
      }

      async function uploadFiles() {
        if (!selectedFiles.length || isUploading) return;

        setUploadingState(true);
        showMessage("Sto inviando le foto...");

        try {
          const fd = new FormData();
          selectedFiles.forEach((file) => fd.append("photos", file));

          const res = await fetch(`${workerBase}/upload`, {
            method: "POST",
            body: fd
          });

          let data;
          try {
            data = await res.json();
          } catch {
            throw new Error("Risposta server non valida");
          }

          if (!res.ok || data?.error) {
            throw new Error(data?.error || "Upload fallito");
          }

          selectedFiles = [];
          cameraInput.value = "";
          galleryInput.value = "";
          updateSelectedFilesUI();
          await loadPhotos();
          showMessage("Foto inviate correttamente.", false);
        } catch {
          showMessage("Invio non riuscito. Riprova.", true);
        } finally {
          setUploadingState(false);
          updateSelectedFilesUI();
        }
      }

      cameraInput?.addEventListener("change", (event) => addFiles(event.target.files));
      galleryInput?.addEventListener("change", (event) => addFiles(event.target.files));
      uploadBtn?.addEventListener("click", uploadFiles);
      refreshBtn?.addEventListener("click", loadPhotos);
      lightboxClose?.addEventListener("click", closeLightbox);

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      lightbox?.addEventListener("cancel", () => {
        lightboxImage.src = "";
        lightboxCaption.textContent = "";
      });

      lightbox?.addEventListener("close", () => {
        lightboxImage.src = "";
        lightboxCaption.textContent = "";
      });

      updateSelectedFilesUI();
      loadPhotos();
    </script>
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    background: #e8eef1;
  }

  body {
    font-family: Montserrat, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--color-text-dark, #221b18);
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  .photo-page {
    min-height: 100vh;
    padding: 16px 12px 36px;
    background:
      radial-gradient(circle at top left, rgba(198, 218, 228, 0.95), transparent 42%),
      linear-gradient(180deg, #dbe8ee 0%, #edf3f6 42%, #f3f6f8 100%);
  }

  .app-shell {
    width: min(100%, 960px);
    margin: 0 auto;
    display: grid;
    gap: 18px;
  }

  .app-hero,
  .upload-panel {
    position: relative;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.56);
    box-shadow: 0 24px 60px rgba(94, 118, 132, 0.12);
    backdrop-filter: blur(12px);
  }

  .app-hero {
    padding: 18px;
  }

  .upload-panel {
    padding: 18px;
  }

  .app-hero-top,
  .upload-panel-head,
  .gallery-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .app-kicker,
  .gallery-label,
  .upload-status-label {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .app-title,
  .upload-title {
    margin: 8px 0 0;
    font-size: clamp(2rem, 6vw, 3.4rem);
    line-height: 0.92;
    text-transform: uppercase;
    letter-spacing: -0.05em;
    color: var(--color-text-dark, #221b18);
  }

  .upload-title {
    font-size: clamp(1.45rem, 4vw, 2rem);
    line-height: 1;
  }

  .app-subtitle,
  .gallery-caption,
  .upload-copy,
  .gallery-message,
  .upload-status-text,
  .gallery-item-meta,
  .photo-lightbox-caption {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(34, 27, 24, 0.78);
  }

  .app-subtitle {
    margin-top: 10px;
    max-width: 34ch;
  }

  .app-live-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-radius: 999px;
    background: rgba(34, 27, 24, 0.08);
    color: var(--color-text-dark, #221b18);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .app-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #86aebf;
    box-shadow: 0 0 0 6px rgba(134, 174, 191, 0.16);
  }

  .gallery-card {
    margin-top: 18px;
    padding: 16px;
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(182, 206, 218, 0.48) 0%, rgba(243, 247, 249, 0.8) 100%);
    border: 1px solid rgba(255, 255, 255, 0.78);
  }

  .gallery-tools {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .gallery-count,
  .gallery-refresh,
  .gallery-page-btn {
    min-width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid rgba(34, 27, 24, 0.08);
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-text-dark, #221b18);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }

  .gallery-refresh,
  .gallery-page-btn,
  .upload-action,
  .photo-lightbox-close,
  .gallery-item-button {
    cursor: pointer;
  }

  .gallery-refresh svg,
  .upload-action-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gallery-message {
    margin-top: 10px;
    margin-bottom: 6px;
  }

  .gallery-message:empty,
  .gallery-message[hidden] {
    display: none;
  }

  .gallery-message[data-error="true"] {
    color: #a04242;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 14px;
  }

  .gallery-item {
    overflow: hidden;
    min-width: 0;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.66);
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 10px 22px rgba(126, 153, 167, 0.12);
  }

  .gallery-item-button {
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
  }

  .gallery-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.5);
  }

  .gallery-image-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .gallery-item-meta {
    padding: 8px 10px 10px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .gallery-pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .gallery-pagination[hidden] {
    display: none;
  }

  .gallery-page-btn[data-active="true"] {
    background: rgba(34, 27, 24, 0.92);
    border-color: rgba(34, 27, 24, 0.92);
    color: #ffffff;
  }

  .gallery-page-dots {
    min-width: 20px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: rgba(34, 27, 24, 0.52);
  }

  .upload-copy {
    max-width: 18ch;
    text-align: right;
  }

  .upload-actions {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .upload-action {
    appearance: none;
    width: 100%;
    border: 0;
    min-height: 124px;
    padding: 16px 14px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: inset 0 0 0 1px rgba(34, 27, 24, 0.06);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    color: var(--color-text-dark, #221b18);
  }

  .upload-action-dark {
    background: rgba(34, 27, 24, 0.92);
    color: #ffffff;
    box-shadow: none;
  }

  .upload-action-accent {
    background: linear-gradient(180deg, #d7e6ed 0%, #c4d9e3 100%);
    color: var(--color-text-dark, #221b18);
    box-shadow: inset 0 0 0 1px rgba(134, 174, 191, 0.25);
  }

  .upload-action:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .upload-action-icon {
    width: 46px;
    height: 46px;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 27, 24, 0.08);
  }

  .upload-action-dark .upload-action-icon {
    background: rgba(255, 255, 255, 0.12);
  }

  .upload-action-accent .upload-action-icon {
    background: rgba(255, 255, 255, 0.66);
  }

  .upload-action-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-start;
  }

  .upload-action-text strong {
    font-size: 15px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .upload-action-text small {
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .upload-status-card {
    margin-top: 14px;
    padding: 14px 16px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: inset 0 0 0 1px rgba(34, 27, 24, 0.05);
  }

  .upload-status-text {
    margin-top: 8px;
    word-break: break-word;
  }

  .photo-lightbox {
    width: min(92vw, 960px);
    max-width: 960px;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .photo-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(4px);
  }

  .photo-lightbox-inner {
    position: relative;
  }

  .photo-lightbox-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    min-height: 42px;
    padding: 10px 14px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(34, 27, 24, 0.62);
    color: #fff;
    font: inherit;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .photo-lightbox-image {
    display: block;
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 18px;
    background: #111;
  }

  .photo-lightbox-caption {
    margin-top: 10px;
    text-align: center;
    color: #f2eee9;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .gallery-refresh:focus-visible,
  .gallery-page-btn:focus-visible,
  .upload-action:focus-visible,
  .gallery-item-button:focus-visible,
  .photo-lightbox-close:focus-visible {
    outline: 3px solid rgba(134, 174, 191, 0.45);
    outline-offset: 3px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
  }

  @media (max-width: 760px) {
    .photo-page {
      padding: 12px 10px 28px;
    }

    .app-hero-top,
    .upload-panel-head,
