---
const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
const publicGalleryPage = "https://wedding-stefano-anna.penz23.org/photo";
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Foto matrimonio</title>
  </head>

  <body>
    <section class="photo-page">
      <div class="shell">
        <header class="hero">
          <p class="eyebrow">Album condiviso</p>
          <h1>Carica le tue foto del matrimonio</h1>
          <p class="intro">
            Scatta, carica e guarda in tempo reale i momenti più belli della giornata.
          </p>

          <div class="hero-actions">
            <label for="photo-input" class="btn btn-primary">Scegli le foto</label>
            <a href="#gallery" class="btn btn-secondary">Guarda la galleria</a>
          </div>

          <input id="photo-input" class="sr-only" type="file" accept="image/*" multiple />

          <div class="status-grid">
            <div class="status-card">
              <span class="status-label">Stato upload</span>
              <strong id="upload-status">Pronto</strong>
            </div>
            <div class="status-card">
              <span class="status-label">Foto visibili</span>
              <strong id="photo-count">0</strong>
            </div>
          </div>
        </header>

        <section class="panel upload-panel">
          <div>
            <p class="panel-kicker">Come funziona</p>
            <h2>Scansiona e condividi</h2>
            <p>
              Apri questa pagina dal QR code, seleziona una o più immagini e le foto compariranno nella galleria comune.
            </p>
          </div>

          <div class="qr-box">
            <div id="qrcode" aria-label="QR code pagina foto"></div>
            <p class="qr-text">Inquadra il codice per aprire direttamente questa pagina.</p>
          </div>
        </section>

        <section id="gallery" class="gallery-section">
          <div class="section-head">
            <div>
              <p class="panel-kicker">Galleria live</p>
              <h2>Tutte le foto degli invitati</h2>
            </div>
            <button id="refresh-btn" class="btn btn-ghost" type="button">Aggiorna</button>
          </div>

          <p id="message" class="message" role="status" aria-live="polite">Sto caricando la galleria...</p>
          <div id="gallery-grid" class="gallery-grid"></div>
        </section>
      </div>
    </section>

    <script type="module">
      import QRCode from "qrcode";

      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
      const publicGalleryPage = "https://wedding-stefano-anna.penz23.org/photo";

      const input = document.getElementById("photo-input");
      const gallery = document.getElementById("gallery-grid");
      const message = document.getElementById("message");
      const uploadStatus = document.getElementById("upload-status");
      const photoCount = document.getElementById("photo-count");
      const refreshBtn = document.getElementById("refresh-btn");
      const qrContainer = document.getElementById("qrcode");

      async function renderQr() {
        const canvas = document.createElement("canvas");
        await QRCode.toCanvas(canvas, publicGalleryPage, {
          width: 220,
          margin: 1,
          color: { dark: "#1f2937", light: "#ffffff" }
        });
        qrContainer.replaceChildren(canvas);
      }

      function showMessage(text, isError = false) {
        message.textContent = text;
        message.dataset.error = isError ? "true" : "false";
      }

      function createPhotoCard(photo) {
        const article = document.createElement("article");
        article.className = "photo-card";

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = "Foto caricata dagli invitati";
        img.loading = "lazy";
        img.decoding = "async";

        const meta = document.createElement("div");
        meta.className = "photo-meta";

        const date = photo.uploaded ? new Date(photo.uploaded) : null;
        meta.textContent =
          date && !Number.isNaN(date.getTime())
            ? date.toLocaleString("it-IT", { dateStyle: "short", timeStyle: "short" })
            : "Appena caricata";

        article.append(img, meta);
        return article;
      }

      async function loadPhotos() {
        try {
          showMessage("Sto caricando la galleria...");
          const res = await fetch(`${workerBase}/photos`);
          if (!res.ok) throw new Error("Errore nel caricamento");
          const photos = await res.json();

          gallery.innerHTML = "";
          photoCount.textContent = String(photos.length);

          if (!photos.length) {
            showMessage("Nessuna foto caricata per ora. Sii il primo a condividere uno scatto.");
            return;
          }

          photos.forEach((photo) => gallery.appendChild(createPhotoCard(photo)));
          showMessage(`Galleria aggiornata: ${photos.length} foto disponibili.`);
        } catch {
          showMessage("Non riesco a caricare la galleria in questo momento.", true);
        }
      }

      async function uploadFiles(files) {
        if (!files?.length) return;

        uploadStatus.textContent = "Caricamento...";
        showMessage(`Sto caricando ${files.length} foto...`);

        try {
          const fd = new FormData();
          [...files].forEach((file) => fd.append("photos", file));

          const res = await fetch(`${workerBase}/upload`, {
            method: "POST",
            body: fd
          });

          const data = await res.json();
          if (!res.ok || data.error) throw new Error(data.error || "Upload fallito");

          uploadStatus.textContent = "Completato";

          const uploadedCount = data.uploaded?.length || 0;
          const skippedCount = data.skipped?.length || 0;

          showMessage(
            skippedCount
              ? `Caricate ${uploadedCount} foto. ${skippedCount} file sono stati saltati.`
              : `Caricate ${uploadedCount} foto con successo.`
          );

          input.value = "";
          await loadPhotos();
        } catch {
          uploadStatus.textContent = "Errore";
          showMessage("Upload non riuscito. Riprova tra qualche secondo.", true);
        }
      }

      input?.addEventListener("change", (event) => {
        uploadFiles(event.target.files);
      });

      refreshBtn?.addEventListener("click", loadPhotos);

      renderQr();
      loadPhotos();
      setInterval(loadPhotos, 20000);
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #faf7f2;
    --surface: rgba(255, 255, 255, 0.82);
    --surface-strong: #ffffff;
    --text: #221b18;
    --muted: #6e625c;
    --line: rgba(34, 27, 24, 0.1);
    --accent: #9f6f5a;
    --accent-dark: #7f5644;
    --shadow: 0 20px 60px rgba(70, 44, 34, 0.12);
    --radius: 24px;
  }

  * { box-sizing: border-box; }
  body { margin: 0; font-family: system-ui, sans-serif; background: var(--bg); color: var(--text); }

  .photo-page {
    background: radial-gradient(circle at top, rgba(159,111,90,.12), transparent 30%), var(--bg);
    min-height: 100vh;
    padding: 4rem 1.25rem 6rem;
  }

  .shell {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    gap: 1.5rem;
  }

  .hero, .panel, .gallery-section {
    background: var(--surface);
    backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .hero { padding: 2rem; text-align: center; }

  .eyebrow, .panel-kicker, .status-label {
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: .78rem;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2.3rem, 5vw, 4.6rem);
    line-height: 1.02;
    margin: .75rem auto 1rem;
    max-width: 12ch;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    line-height: 1.1;
    margin: .35rem 0 .75rem;
  }

  .intro, .panel p, .qr-text, .message, .photo-meta {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .intro { max-width: 620px; margin: 0 auto; }

  .hero-actions, .section-head, .status-grid {
    display: flex;
    gap: .9rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero-actions, .status-grid {
    justify-content: center;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: .85rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid transparent;
    font-weight: 600;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .btn-primary { background: var(--accent); color: white; }
  .btn-primary:hover { background: var(--accent-dark); }
  .btn-secondary, .btn-ghost { border-color: var(--line); }

  .status-card {
    min-width: 155px;
    background: var(--surface-strong);
    border-radius: 18px;
    border: 1px solid var(--line);
    padding: 1rem 1.1rem;
    text-align: left;
  }

  .status-card strong {
    display: block;
    font-size: 1.2rem;
    margin-top: .35rem;
  }

  .panel, .gallery-section { padding: 1.4rem; }

  .upload-panel {
    display: grid;
    grid-template-columns: 1.3fr .8fr;
    gap: 1.25rem;
    align-items: center;
  }

  .qr-box {
    background: var(--surface-strong);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 1rem;
    display: grid;
    justify-items: center;
    gap: .9rem;
  }

  #qrcode canvas { width: min(220px, 100%); height: auto; border-radius: 18px; }

  .section-head { justify-content: space-between; margin-bottom: 1rem; }

  .message[data-error="true"] { color: #a04242; }

  .gallery-grid {
    margin-top: 1.1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: .9rem;
  }

  .photo-card {
    overflow: hidden;
    border-radius: 20px;
    background: var(--surface-strong);
    border: 1px solid var(--line);
  }

  .photo-card img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    background: #efe7df;
  }

  .photo-meta { padding: .8rem .9rem 1rem; font-size: .92rem; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .photo-page { padding: 1rem .85rem 4rem; }
    .hero { padding: 1.4rem; text-align: left; }
    .hero-actions > *, .section-head > *, .btn { width: 100%; }
    .upload-panel { grid-template-columns: 1fr; }
  }
</style>