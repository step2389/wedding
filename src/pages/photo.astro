<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Foto matrimonio</title>
  </head>
  <body>
    <main class="photo-page font-montserrat">
      <div class="app-shell">
        <section class="gallery-panel" aria-label="Galleria live">
          <div class="gallery-header">
            <p class="gallery-title">Galleria live</p>

            <div class="gallery-tools">
              <span id="photo-count" class="gallery-count" aria-label="Numero totale foto">0</span>
              <button id="refresh-btn" class="gallery-refresh" type="button" aria-label="Aggiorna galleria" title="Aggiorna galleria">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                  <path d="M21 3v6h-6" />
                </svg>
              </button>
            </div>
          </div>

          <p id="message" class="gallery-message" role="status" aria-live="polite"></p>
          <div id="gallery-grid" class="gallery-grid"></div>
          <div id="gallery-pagination" class="gallery-pagination" aria-label="Pagine galleria"></div>
        </section>
      </div>

      <div class="upload-dock-wrap">
        <section class="upload-dock" aria-label="Azioni caricamento foto">
          <input id="camera-input" class="sr-only" type="file" accept="image/*" capture="environment" />
          <input id="gallery-input" class="sr-only" type="file" accept="image/*" multiple />

          <label for="camera-input" class="dock-action dock-action-secondary dock-action-camera">
            <span class="dock-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M4 7h3l1.5-2h7L17 7h3v11H4z" />
                <circle cx="12" cy="13" r="4" />
              </svg>
            </span>
            <span class="dock-texts">
              <span class="dock-label">Foto</span>
              <span class="dock-sub">Scatta</span>
            </span>
          </label>

          <label for="gallery-input" class="dock-action dock-action-secondary dock-action-gallery">
            <span class="dock-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="4" y="5" width="16" height="14" rx="3" />
                <path d="M8 14l2.5-2.5 2.5 2.5 3.5-4 3.5 4.5" />
                <circle cx="9" cy="9" r="1.2" />
              </svg>
            </span>
            <span class="dock-texts">
              <span class="dock-label">Galleria</span>
              <span class="dock-sub">Scegli</span>
            </span>
          </label>

          <button id="upload-btn" class="dock-action dock-action-primary" type="button" disabled>
            <span class="dock-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M12 16V6" />
                <path d="M8.5 9.5 12 6l3.5 3.5" />
                <path d="M5 18.5h14" />
              </svg>
            </span>
            <span class="dock-texts dock-texts-primary">
              <span id="upload-btn-label" class="dock-label dock-label-strong">Invia foto</span>
              <span id="upload-btn-sub" class="dock-sub dock-sub-primary">Seleziona prima</span>
            </span>
            <span id="upload-count-badge" class="upload-count-badge" hidden>0</span>
          </button>
        </section>
      </div>
    </main>

    <dialog id="lightbox" class="photo-lightbox" aria-label="Foto ingrandita">
      <div class="photo-lightbox-inner">
        <button id="lightbox-close" class="photo-lightbox-close" type="button" aria-label="Chiudi immagine">Chiudi</button>
        <img id="lightbox-image" class="photo-lightbox-image" alt="Foto ingrandita" />
        <p id="lightbox-caption" class="photo-lightbox-caption"></p>
      </div>
    </dialog>

    <script type="module">
      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
      const MAX_FILES = 20;
      const MAX_FILE_SIZE = 10 * 1024 * 1024;
      const PHOTOS_PER_PAGE = 18;

      const cameraInput = document.getElementById("camera-input");
      const galleryInput = document.getElementById("gallery-input");
      const uploadBtn = document.getElementById("upload-btn");
      const uploadBtnLabel = document.getElementById("upload-btn-label");
      const uploadBtnSub = document.getElementById("upload-btn-sub");
      const uploadCountBadge = document.getElementById("upload-count-badge");
      const refreshBtn = document.getElementById("refresh-btn");
      const gallery = document.getElementById("gallery-grid");
      const pagination = document.getElementById("gallery-pagination");
      const message = document.getElementById("message");
      const photoCount = document.getElementById("photo-count");
      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxCaption = document.getElementById("lightbox-caption");
      const lightboxClose = document.getElementById("lightbox-close");

      let selectedFiles = [];
      let isUploading = false;
      let allPhotos = [];
      let currentPage = 1;

      function showMessage(text = "", isError = false) {
        message.textContent = text;
        message.dataset.error = isError ? "true" : "false";
        message.hidden = !text;
      }

      function setUploadingState(nextUploading) {
        isUploading = nextUploading;
        cameraInput.disabled = nextUploading;
        galleryInput.disabled = nextUploading;
        refreshBtn.disabled = nextUploading;
        uploadBtn.disabled = nextUploading || !selectedFiles.length;

        if (nextUploading) {
          uploadBtnLabel.textContent = "Invio foto";
          uploadBtnSub.textContent = "Caricamento...";
        } else {
          updateUploadButton();
        }
      }

      function updateUploadButton() {
        const count = selectedFiles.length;

        if (!count) {
          uploadBtnLabel.textContent = "Invia foto";
          uploadBtnSub.textContent = "Seleziona prima";
          uploadCountBadge.hidden = true;
          uploadBtn.disabled = true;
          return;
        }

        uploadBtnLabel.textContent = "Invia foto";
        uploadBtnSub.textContent = count === 1 ? "1 foto pronta" : `${count} foto pronte`;
        uploadCountBadge.textContent = String(count);
        uploadCountBadge.hidden = false;
        uploadBtn.disabled = isUploading;
      }

      function normalizeFiles(fileList) {
        return Array.from(fileList || []).filter((file) => file.type.startsWith("image/") && file.size <= MAX_FILE_SIZE);
      }

      function addFiles(fileList) {
        const validFiles = normalizeFiles(fileList);

        if (!validFiles.length) {
          showMessage("Seleziona immagini valide fino a 10 MB.", true);
          return;
        }

        selectedFiles = [...selectedFiles, ...validFiles].slice(0, MAX_FILES);
        updateUploadButton();
        showMessage("");
      }

      function formatUploadedLabel(uploaded) {
        const date = uploaded ? new Date(uploaded) : null;
        return date && !Number.isNaN(date.getTime())
          ? date.toLocaleString("it-IT", { dateStyle: "short", timeStyle: "short" })
          : "Appena caricata";
      }

      function openLightbox(url, caption = "") {
        lightboxImage.src = url;
        lightboxCaption.textContent = caption;
        if (!lightbox.open) lightbox.showModal();
      }

      function closeLightbox() {
        if (lightbox.open) lightbox.close();
      }

      function createPhotoCard(photo, index) {
        const card = document.createElement("article");
        card.className = "gallery-item";

        const button = document.createElement("button");
        button.type = "button";
        button.className = "gallery-item-button";

        const uploadedLabel = formatUploadedLabel(photo.uploaded);
        button.setAttribute("aria-label", `Apri foto ${index + 1}, caricata ${uploadedLabel}`);
        button.addEventListener("click", () => openLightbox(photo.url, uploadedLabel));

        const imageWrap = document.createElement("div");
        imageWrap.className = "gallery-image-wrap";

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = `Foto caricata ${uploadedLabel}`;
        img.loading = "lazy";
        img.decoding = "async";

        const meta = document.createElement("div");
        meta.className = "gallery-item-meta";
        meta.textContent = uploadedLabel;

        imageWrap.appendChild(img);
        button.appendChild(imageWrap);
        card.appendChild(button);
        card.appendChild(meta);
        return card;
      }

      function renderPagination(totalPages) {
        pagination.innerHTML = "";

        if (totalPages <= 1) {
          pagination.hidden = true;
          return;
        }

        pagination.hidden = false;

        const pages = new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1]);

        const orderedPages = [...pages]
          .filter((page) => page >= 1 && page <= totalPages)
          .sort((a, b) => a - b);

        let lastPage = 0;

        orderedPages.forEach((page) => {
          if (page - lastPage > 1) {
            const dots = document.createElement("span");
            dots.className = "gallery-page-dots";
            dots.textContent = "...";
            dots.setAttribute("aria-hidden", "true");
            pagination.appendChild(dots);
          }

          const button = document.createElement("button");
          button.type = "button";
          button.className = "gallery-page-btn";
          button.textContent = String(page);
          button.setAttribute("aria-label", `Vai alla pagina ${page}`);

          if (page === currentPage) {
            button.dataset.active = "true";
            button.setAttribute("aria-current", "page");
          }

          button.addEventListener("click", () => {
            if (page === currentPage) return;
            currentPage = page;
            renderGallery();
          });

          pagination.appendChild(button);
          lastPage = page;
        });
      }

      function renderGallery() {
        gallery.innerHTML = "";

        if (!allPhotos.length) {
          pagination.hidden = true;
          return;
        }

        const totalPages = Math.max(1, Math.ceil(allPhotos.length / PHOTOS_PER_PAGE));
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * PHOTOS_PER_PAGE;
        const visiblePhotos = allPhotos.slice(start, start + PHOTOS_PER_PAGE);
        const frag = document.createDocumentFragment();

        visiblePhotos.forEach((photo, index) => {
          frag.appendChild(createPhotoCard(photo, start + index));
        });

        gallery.appendChild(frag);
        renderPagination(totalPages);
      }

      async function loadPhotos() {
        try {
          showMessage("");
          const res = await fetch(`${workerBase}/photos`, { cache: "no-store" });
          if (!res.ok) throw new Error("Errore nel caricamento galleria");

          allPhotos = await res.json();
          photoCount.textContent = String(allPhotos.length);

          if (!allPhotos.length) {
            gallery.innerHTML = "";
            pagination.hidden = true;
            showMessage("La galleria è ancora vuota.", false);
            return;
          }

          renderGallery();
          showMessage("");
        } catch {
          showMessage("Non riesco a caricare la galleria.", true);
        }
      }

      async function uploadFiles() {
        if (!selectedFiles.length || isUploading) return;

        setUploadingState(true);
        showMessage("Sto inviando le foto...");

        try {
          const fd = new FormData();
          selectedFiles.forEach((file) => fd.append("photos", file));

          const res = await fetch(`${workerBase}/upload`, {
            method: "POST",
            body: fd
          });

          let data;
          try {
            data = await res.json();
          } catch {
            throw new Error("Risposta server non valida");
          }

          if (!res.ok || data?.error) {
            throw new Error(data?.error || "Upload fallito");
          }

          selectedFiles = [];
          cameraInput.value = "";
          galleryInput.value = "";
          updateUploadButton();
          await loadPhotos();
          showMessage("Foto inviate correttamente.", false);
        } catch {
          showMessage("Invio non riuscito. Riprova.", true);
        } finally {
          setUploadingState(false);
          updateUploadButton();
        }
      }

      cameraInput?.addEventListener("change", (event) => addFiles(event.target.files));
      galleryInput?.addEventListener("change", (event) => addFiles(event.target.files));
      uploadBtn?.addEventListener("click", uploadFiles);
      refreshBtn?.addEventListener("click", loadPhotos);
      lightboxClose?.addEventListener("click", closeLightbox);

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      lightbox?.addEventListener("cancel", () => {
        lightboxImage.src = "";
        lightboxCaption.textContent = "";
      });

      lightbox?.addEventListener("close", () => {
        lightboxImage.src = "";
        lightboxCaption.textContent = "";
      });

      updateUploadButton();
      loadPhotos();
    </script>
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    background: #edf2f5;
  }

  body {
    font-family: Montserrat, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #221b18;
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  .photo-page {
    min-height: 100vh;
    padding: 10px 10px 128px;
    background: linear-gradient(180deg, #e4edf1 0%, #eef3f6 50%, #f5f7f8 100%);
  }

  .app-shell {
    width: min(100%, 960px);
    margin: 0 auto;
  }

  .gallery-panel {
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.92);
    box-shadow: 0 20px 44px rgba(103, 126, 138, 0.12);
    backdrop-filter: blur(14px);
    padding: 14px;
  }

  .gallery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .gallery-title {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(34, 27, 24, 0.82);
  }

  .gallery-tools {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .gallery-count,
  .gallery-refresh,
  .gallery-page-btn {
    min-width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid rgba(34, 27, 24, 0.07);
    background: rgba(255, 255, 255, 0.95);
    color: #221b18;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }

  .gallery-refresh,
  .gallery-page-btn,
  .gallery-item-button,
  .photo-lightbox-close,
  .dock-action {
    cursor: pointer;
  }

  .gallery-refresh svg,
  .dock-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gallery-message {
    margin: 0 0 10px;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(34, 27, 24, 0.66);
  }

  .gallery-message:empty,
  .gallery-message[hidden] {
    display: none;
  }

  .gallery-message[data-error="true"] {
    color: #a04242;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .gallery-item {
    overflow: hidden;
    min-width: 0;
    border-radius: 19px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 8px 18px rgba(115, 137, 149, 0.08);
  }

  .gallery-item-button {
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
  }

  .gallery-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #dfe8ec;
  }

  .gallery-image-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 180ms ease;
  }

  .gallery-item-button:hover .gallery-image-wrap img,
  .gallery-item-button:focus-visible .gallery-image-wrap img {
    transform: scale(1.03);
  }

  .gallery-item-meta {
    padding: 8px 8px 2px;
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(34, 27, 24, 0.52);
  }

  .gallery-pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .gallery-pagination[hidden] {
    display: none;
  }

  .gallery-page-btn[data-active="true"] {
    background: rgba(34, 27, 24, 0.92);
    border-color: rgba(34, 27, 24, 0.92);
    color: #ffffff;
  }

  .gallery-page-dots {
    min-width: 20px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: rgba(34, 27, 24, 0.46);
  }

  .upload-dock-wrap {
    position: fixed;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 10px);
    transform: translateX(-50%);
    width: min(calc(100% - 20px), 760px);
    z-index: 40;
  }

  .upload-dock {
    display: grid;
    grid-template-columns: 1fr 1fr 1.24fr;
    gap: 9px;
    padding: 9px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.96);
    box-shadow: 0 18px 38px rgba(74, 94, 105, 0.18);
    backdrop-filter: blur(22px);
  }

  .dock-action {
    position: relative;
    appearance: none;
    border: 0;
    min-height: 70px;
    padding: 12px 14px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    text-decoration: none;
    color: #221b18;
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .dock-action:hover {
    transform: translateY(-1px);
  }

  .dock-action-secondary {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(245, 248, 250, 0.98) 100%);
    box-shadow:
      inset 0 0 0 1px rgba(34, 27, 24, 0.05),
      0 8px 18px rgba(129, 148, 159, 0.08);
  }

  .dock-action-camera .dock-icon {
    background: linear-gradient(180deg, rgba(34, 27, 24, 0.1) 0%, rgba(34, 27, 24, 0.06) 100%);
  }

  .dock-action-gallery .dock-icon {
    background: linear-gradient(180deg, rgba(134, 174, 191, 0.2) 0%, rgba(134, 174, 191, 0.1) 100%);
  }

  .dock-action-primary {
    background: linear-gradient(180deg, #2f2724 0%, #221b18 100%);
    color: #ffffff;
    box-shadow: 0 12px 22px rgba(34, 27, 24, 0.2);
  }

  .dock-action:disabled {
    opacity: 0.72;
    cursor: not-allowed;
  }

  .dock-action:disabled:hover {
    transform: none;
  }

  .dock-icon {
    width: 40px;
    height: 40px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 27, 24, 0.06);
    flex: 0 0 auto;
  }

  .dock-action-primary .dock-icon {
    background: rgba(255, 255, 255, 0.12);
  }

  .dock-texts {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .dock-texts-primary {
    padding-right: 32px;
  }

  .dock-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .dock-label-strong {
    letter-spacing: 0.04em;
  }

  .dock-sub {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(34, 27, 24, 0.46);
    line-height: 1.1;
  }

  .dock-sub-primary {
    color: rgba(255, 255, 255, 0.7);
  }

  .upload-count-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    min-width: 24px;
    height: 24px;
    padding: 0 7px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    color: #221b18;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
  }

  .photo-lightbox {
    width: min(92vw, 960px);
    max-width: 960px;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .photo-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(4px);
  }

  .photo-lightbox-inner {
    position: relative;
  }

  .photo-lightbox-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    min-height: 42px;
    padding: 10px 14px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(34, 27, 24, 0.62);
    color: #fff;
    font: inherit;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .photo-lightbox-image {
    display: block;
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 18px;
    background: #111;
  }

  .photo-lightbox-caption {
    margin-top: 10px;
    text-align: center;
    color: #f2eee9;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .gallery-refresh:focus-visible,
  .gallery-page-btn:focus-visible,
  .dock-action:focus-visible,
  .gallery-item-button:focus-visible,
  .photo-lightbox-close:focus-visible {
    outline: 3px solid rgba(134, 174, 191, 0.4);
    outline-offset: 3px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
  }

  @media (max-width: 760px) {
    .photo-page {
      padding: 10px 8px 124px;
    }

    .upload-dock-wrap {
      width: calc(100% - 16px);
      bottom: calc(env(safe-area-inset-bottom, 0px) + 8px);
    }
  }

  @media (max-width: 560px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .gallery-item-meta {
      font-size: 8px;
      padding: 7px 6px 2px;
    }

    .gallery-count,
    .gallery-refresh,
    .gallery-page-btn {
      min-width: 34px;
      height: 34px;
      padding: 0 10px;
      font-size: 10px;
    }

    .gallery-page-dots {
      height: 34px;
    }

    .upload-dock {
      grid-template-columns: 1fr 1fr 1.1fr;
      gap: 8px;
      padding: 8px;
      border-radius: 24px;
    }

    .dock-action {
      min-height: 62px;
      padding: 10px 10px;
      border-radius: 18px;
      justify-content: center;
    }

    .dock-texts {
      display: none;
    }

    .dock-icon {
      width: 36px;
      height: 36px;
      border-radius: 12px;
    }

    .upload-count-badge {
      top: 6px;
      right: 6px;
