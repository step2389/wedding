---
const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Foto matrimonio</title>
  </head>

  <body>
    <section class="wedding-photo-page">
      <div class="wedding-photo-shell">
        <header class="wedding-photo-hero">
          <p class="wedding-photo-eyebrow">Album condiviso</p>
          <h1 class="wedding-photo-title">Carica le tue foto del matrimonio</h1>
          <p class="wedding-photo-intro">
            Puoi scattare una foto al momento oppure scegliere immagini già presenti sul telefono. Poi premi il pulsante di upload per aggiungerle alla galleria condivisa.
          </p>

          <div class="wedding-photo-actions">
            <label for="camera-input" class="wedding-photo-btn wedding-photo-btn-primary">Scatta una foto</label>
            <label for="gallery-input" class="wedding-photo-btn wedding-photo-btn-secondary">Scegli dalla galleria</label>
            <button id="upload-btn" class="wedding-photo-btn wedding-photo-btn-accent" type="button" disabled>Carica adesso</button>
          </div>

          <input id="camera-input" class="wedding-photo-sr-only" type="file" accept="image/*" capture="environment" />
          <input id="gallery-input" class="wedding-photo-sr-only" type="file" accept="image/*" multiple />

          <p id="selected-files" class="wedding-photo-selected">Nessuna foto selezionata.</p>

          <div class="wedding-photo-status-grid">
            <div class="wedding-photo-status-card">
              <span class="wedding-photo-status-label">Stato upload</span>
              <strong id="upload-status">Pronto</strong>
            </div>
            <div class="wedding-photo-status-card">
              <span class="wedding-photo-status-label">Foto visibili</span>
              <strong id="photo-count">0</strong>
            </div>
          </div>
        </header>

        <section id="gallery" class="wedding-photo-gallery-section">
          <div class="wedding-photo-section-head">
            <div>
              <p class="wedding-photo-eyebrow">Galleria live</p>
              <h2 class="wedding-photo-subtitle">Tutte le foto degli invitati</h2>
            </div>
            <button id="refresh-btn" class="wedding-photo-btn wedding-photo-btn-ghost" type="button">Aggiorna</button>
          </div>

          <p id="message" class="wedding-photo-message" role="status" aria-live="polite">Sto caricando la galleria...</p>
          <div id="gallery-grid" class="wedding-photo-grid"></div>
        </section>
      </div>
    </section>

    <script type="module">
      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";

      const cameraInput = document.getElementById("camera-input");
      const galleryInput = document.getElementById("gallery-input");
      const uploadBtn = document.getElementById("upload-btn");
      const selectedFilesText = document.getElementById("selected-files");
      const gallery = document.getElementById("gallery-grid");
      const message = document.getElementById("message");
      const uploadStatus = document.getElementById("upload-status");
      const photoCount = document.getElementById("photo-count");
      const refreshBtn = document.getElementById("refresh-btn");

      let selectedFiles = [];

      function showMessage(text, isError = false) {
        message.textContent = text;
        message.dataset.error = isError ? "true" : "false";
      }

      function updateSelectedFilesUI() {
        if (!selectedFiles.length) {
          selectedFilesText.textContent = "Nessuna foto selezionata.";
          uploadBtn.disabled = true;
          return;
        }

        const names = selectedFiles.slice(0, 2).map((file) => file.name).join(", ");
        const extra = selectedFiles.length > 2 ? ` +${selectedFiles.length - 2} altre` : "";
        selectedFilesText.textContent = `${selectedFiles.length} foto selezionate: ${names}${extra}`;
        uploadBtn.disabled = false;
      }

      function setSelectedFiles(files, mode = "append") {
        const next = Array.from(files || []);
        if (!next.length) return;

        if (mode === "append") {
          selectedFiles = [...selectedFiles, ...next];
        } else {
          selectedFiles = next;
        }

        updateSelectedFilesUI();
      }

      function createPhotoCard(photo) {
        const card = document.createElement("article");
        card.className = "wedding-photo-card";

        const link = document.createElement("a");
        link.href = photo.url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.className = "wedding-photo-card-link";
        link.setAttribute("aria-label", "Apri foto intera");

        const media = document.createElement("div");
        media.className = "wedding-photo-card-media";

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = "Foto caricata dagli invitati";
        img.loading = "lazy";
        img.decoding = "async";

        media.appendChild(img);
        link.appendChild(media);

        const meta = document.createElement("div");
        meta.className = "wedding-photo-card-meta";

        const date = photo.uploaded ? new Date(photo.uploaded) : null;
        meta.textContent =
          date && !Number.isNaN(date.getTime())
            ? date.toLocaleString("it-IT", { dateStyle: "short", timeStyle: "short" })
            : "Appena caricata";

        card.append(link, meta);
        return card;
      }

      async function loadPhotos() {
        try {
          showMessage("Sto caricando la galleria...");
          const res = await fetch(`${workerBase}/photos`, { cache: "no-store" });
          if (!res.ok) throw new Error("Errore nel caricamento");
          const photos = await res.json();

          gallery.innerHTML = "";
          photoCount.textContent = String(photos.length);

          if (!photos.length) {
            showMessage("Nessuna foto caricata per ora. Sii il primo a condividere uno scatto.");
            return;
          }

          const fragment = document.createDocumentFragment();
          photos.forEach((photo) => fragment.appendChild(createPhotoCard(photo)));
          gallery.appendChild(fragment);
          showMessage(`Galleria aggiornata: ${photos.length} foto disponibili.`);
        } catch {
          showMessage("Non riesco a caricare la galleria in questo momento.", true);
        }
      }

      async function uploadFiles() {
        if (!selectedFiles.length) return;

        uploadBtn.disabled = true;
        uploadStatus.textContent = "Caricamento...";
        showMessage(`Sto caricando ${selectedFiles.length} foto...`);

        try {
          const fd = new FormData();
          selectedFiles.forEach((file) => fd.append("photos", file));

          const res = await fetch(`${workerBase}/upload`, {
            method: "POST",
            body: fd
          });

          const data = await res.json();
          if (!res.ok || data.error) throw new Error(data.error || "Upload fallito");

          uploadStatus.textContent = "Completato";

          const uploadedCount = data.uploaded?.length || 0;
          const skippedCount = data.skipped?.length || 0;

          showMessage(
            skippedCount
              ? `Caricate ${uploadedCount} foto. ${skippedCount} file sono stati saltati.`
              : `Caricate ${uploadedCount} foto con successo.`
          );

          selectedFiles = [];
          cameraInput.value = "";
          galleryInput.value = "";
          updateSelectedFilesUI();
          await loadPhotos();
        } catch {
          uploadStatus.textContent = "Errore";
          showMessage("Upload non riuscito. Riprova tra qualche secondo.", true);
          uploadBtn.disabled = false;
        }
      }

      cameraInput?.addEventListener("change", (event) => {
        setSelectedFiles(event.target.files, "append");
      });

      galleryInput?.addEventListener("change", (event) => {
        setSelectedFiles(event.target.files, "append");
      });

      uploadBtn?.addEventListener("click", uploadFiles);
      refreshBtn?.addEventListener("click", loadPhotos);

      updateSelectedFilesUI();
      loadPhotos();
      setInterval(loadPhotos, 20000);
    </script>
  </body>
</html>

<style>
  .wedding-photo-page,
  .wedding-photo-page * ,
  .wedding-photo-page *::before,
  .wedding-photo-page *::after {
    box-sizing: border-box;
  }

  .wedding-photo-page {
    min-height: 100vh;
    padding: 24px 14px 64px;
    background: radial-gradient(circle at top, rgba(159, 111, 90, 0.12), transparent 30%), #faf7f2;
    color: #221b18;
    overflow-x: hidden;
  }

  .wedding-photo-shell {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    gap: 24px;
  }

  .wedding-photo-hero,
  .wedding-photo-gallery-section {
    width: 100%;
    min-width: 0;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(34, 27, 24, 0.1);
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(70, 44, 34, 0.12);
  }

  .wedding-photo-hero {
    padding: 24px;
    text-align: center;
  }

  .wedding-photo-gallery-section {
    padding: 22px;
  }

  .wedding-photo-eyebrow,
  .wedding-photo-status-label {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 12px;
    color: #6e625c;
  }

  .wedding-photo-title {
    margin: 10px auto 14px;
    max-width: 12ch;
    font-size: clamp(2.1rem, 5vw, 4rem);
    line-height: 1.03;
    font-family: "Montserrat", "Playfair Display", serif;
  }

  .wedding-photo-subtitle {
    margin: 6px 0 10px;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.1;
    font-family: "Montserrat", "Playfair Display", serif;
  }

  .wedding-photo-intro,
  .wedding-photo-message,
  .wedding-photo-card-meta,
  .wedding-photo-selected {
    margin: 0;
    color: #6e625c;
    font-size: 16px;
    line-height: 1.65;
  }

  .wedding-photo-intro {
    max-width: 640px;
    margin-inline: auto;
  }

  .wedding-photo-actions,
  .wedding-photo-status-grid,
  .wedding-photo-section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .wedding-photo-actions,
  .wedding-photo-status-grid {
    justify-content: center;
    margin-top: 20px;
  }

  .wedding-photo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 0;
    padding: 14px 20px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: #221b18;
    font: inherit;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .wedding-photo-btn-primary {
    background: #9f6f5a;
    color: #fff;
  }

  .wedding-photo-btn-secondary,
  .wedding-photo-btn-ghost {
    border-color: rgba(34, 27, 24, 0.1);
    background: #fff;
  }

  .wedding-photo-btn-accent {
    border-color: rgba(159, 111, 90, 0.24);
    background: #efe3db;
  }

  .wedding-photo-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .wedding-photo-selected {
    margin-top: 14px;
    word-break: break-word;
  }

  .wedding-photo-status-card {
    width: 100%;
    min-width: 0;
    max-width: 220px;
    padding: 16px 18px;
    border-radius: 18px;
    border: 1px solid rgba(34, 27, 24, 0.1);
    background: #fff;
    text-align: left;
  }

  .wedding-photo-status-card strong {
    display: block;
    margin-top: 6px;
    font-size: 1.15rem;
  }

  .wedding-photo-section-head {
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .wedding-photo-message[data-error="true"] {
    color: #a04242;
  }

  .wedding-photo-grid {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    min-width: 0;
  }

  .wedding-photo-card {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(34, 27, 24, 0.1);
    background: #fff;
  }

  .wedding-photo-card-link {
    display: block;
    width: 100%;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .wedding-photo-card-media {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #efe7df;
  }

  .wedding-photo-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .wedding-photo-card-meta {
    padding: 12px 14px 14px;
    font-size: 14px;
  }

  .wedding-photo-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 700px) {
    .wedding-photo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .wedding-photo-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .wedding-photo-page {
      padding: 14px 10px 48px;
    }

    .wedding-photo-hero,
    .wedding-photo-gallery-section {
      padding: 18px;
    }

    .wedding-photo-hero {
      text-align: left;
    }

    .wedding-photo-actions > *,
    .wedding-photo-section-head > *,
    .wedding-photo-btn {
      width: 100%;
    }

    .wedding-photo-status-grid {
      justify-content: stretch;
    }

    .wedding-photo-status-card {
      max-width: none;
    }
  }
</style>