---
const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Foto matrimonio</title>
  </head>

  <body>
    <section class="photo-page">
      <div class="shell">
        <header class="hero">
          <p class="eyebrow">Album condiviso</p>
          <h1>Carica le tue foto del matrimonio</h1>
          <p class="intro">
            Scegli le immagini dal telefono, poi premi il pulsante di upload per aggiungerle alla galleria condivisa.
          </p>

          <div class="hero-actions">
            <label for="photo-input" class="btn btn-primary">Scegli le foto</label>
            <button id="upload-btn" class="btn btn-accent" type="button" disabled>Carica adesso</button>
            <a href="#gallery" class="btn btn-secondary">Guarda la galleria</a>
          </div>

          <input id="photo-input" class="sr-only" type="file" accept="image/*" multiple />

          <p id="selected-files" class="selected-files">Nessuna foto selezionata.</p>

          <div class="status-grid">
            <div class="status-card">
              <span class="status-label">Stato upload</span>
              <strong id="upload-status">Pronto</strong>
            </div>
            <div class="status-card">
              <span class="status-label">Foto visibili</span>
              <strong id="photo-count">0</strong>
            </div>
          </div>
        </header>

        <section id="gallery" class="gallery-section">
          <div class="section-head">
            <div>
              <p class="panel-kicker">Galleria live</p>
              <h2>Tutte le foto degli invitati</h2>
            </div>
            <button id="refresh-btn" class="btn btn-ghost" type="button">Aggiorna</button>
          </div>

          <p id="message" class="message" role="status" aria-live="polite">Sto caricando la galleria...</p>
          <div id="gallery-grid" class="gallery-grid"></div>
        </section>
      </div>
    </section>

    <dialog id="lightbox" class="lightbox">
      <button id="lightbox-close" class="lightbox-close" type="button" aria-label="Chiudi foto">×</button>
      <img id="lightbox-image" src="" alt="Anteprima foto" />
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </dialog>

    <script type="module">
      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";

      const input = document.getElementById("photo-input");
      const uploadBtn = document.getElementById("upload-btn");
      const selectedFilesText = document.getElementById("selected-files");
      const gallery = document.getElementById("gallery-grid");
      const message = document.getElementById("message");
      const uploadStatus = document.getElementById("upload-status");
      const photoCount = document.getElementById("photo-count");
      const refreshBtn = document.getElementById("refresh-btn");
      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxCaption = document.getElementById("lightbox-caption");
      const lightboxClose = document.getElementById("lightbox-close");

      let selectedFiles = [];

      function showMessage(text, isError = false) {
        message.textContent = text;
        message.dataset.error = isError ? "true" : "false";
      }

      function updateSelectedFilesUI() {
        if (!selectedFiles.length) {
          selectedFilesText.textContent = "Nessuna foto selezionata.";
          uploadBtn.disabled = true;
          return;
        }

        const names = selectedFiles.slice(0, 2).map((file) => file.name).join(", ");
        const extra = selectedFiles.length > 2 ? ` +${selectedFiles.length - 2} altre` : "";
        selectedFilesText.textContent = `${selectedFiles.length} foto selezionate: ${names}${extra}`;
        uploadBtn.disabled = false;
      }

      function openLightbox(photo) {
        lightboxImage.src = photo.url;
        lightboxImage.alt = "Foto caricata dagli invitati";
        const date = photo.uploaded ? new Date(photo.uploaded) : null;
        lightboxCaption.textContent =
          date && !Number.isNaN(date.getTime())
            ? `Caricata il ${date.toLocaleString("it-IT", { dateStyle: "medium", timeStyle: "short" })}`
            : "Foto caricata dagli invitati";
        lightbox.showModal();
      }

      function closeLightbox() {
        lightbox.close();
        lightboxImage.src = "";
      }

      function createPhotoCard(photo) {
        const article = document.createElement("article");
        article.className = "photo-card";

        const button = document.createElement("button");
        button.type = "button";
        button.className = "photo-trigger";
        button.setAttribute("aria-label", "Apri foto ingrandita");
        button.addEventListener("click", () => openLightbox(photo));

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = "Foto caricata dagli invitati";
        img.loading = "lazy";
        img.decoding = "async";

        const meta = document.createElement("div");
        meta.className = "photo-meta";

        const date = photo.uploaded ? new Date(photo.uploaded) : null;
        meta.textContent =
          date && !Number.isNaN(date.getTime())
            ? date.toLocaleString("it-IT", { dateStyle: "short", timeStyle: "short" })
            : "Appena caricata";

        button.appendChild(img);
        article.append(button, meta);
        return article;
      }

      async function loadPhotos() {
        try {
          showMessage("Sto caricando la galleria...");
          const res = await fetch(`${workerBase}/photos`);
          if (!res.ok) throw new Error("Errore nel caricamento");
          const photos = await res.json();

          gallery.innerHTML = "";
          photoCount.textContent = String(photos.length);

          if (!photos.length) {
            showMessage("Nessuna foto caricata per ora. Sii il primo a condividere uno scatto.");
            return;
          }

          photos.forEach((photo) => gallery.appendChild(createPhotoCard(photo)));
          showMessage(`Galleria aggiornata: ${photos.length} foto disponibili.`);
        } catch {
          showMessage("Non riesco a caricare la galleria in questo momento.", true);
        }
      }

      async function uploadFiles() {
        if (!selectedFiles.length) return;

        uploadBtn.disabled = true;
        uploadStatus.textContent = "Caricamento...";
        showMessage(`Sto caricando ${selectedFiles.length} foto...`);

        try {
          const fd = new FormData();
          selectedFiles.forEach((file) => fd.append("photos", file));

          const res = await fetch(`${workerBase}/upload`, {
            method: "POST",
            body: fd
          });

          const data = await res.json();
          if (!res.ok || data.error) throw new Error(data.error || "Upload fallito");

          uploadStatus.textContent = "Completato";

          const uploadedCount = data.uploaded?.length || 0;
          const skippedCount = data.skipped?.length || 0;

          showMessage(
            skippedCount
              ? `Caricate ${uploadedCount} foto. ${skippedCount} file sono stati saltati.`
              : `Caricate ${uploadedCount} foto con successo.`
          );

          selectedFiles = [];
          input.value = "";
          updateSelectedFilesUI();
          await loadPhotos();
        } catch {
          uploadStatus.textContent = "Errore";
          showMessage("Upload non riuscito. Riprova tra qualche secondo.", true);
          uploadBtn.disabled = false;
        }
      }

      input?.addEventListener("change", (event) => {
        selectedFiles = Array.from(event.target.files || []);
        updateSelectedFilesUI();
      });

      uploadBtn?.addEventListener("click", uploadFiles);
      refreshBtn?.addEventListener("click", loadPhotos);
      lightboxClose?.addEventListener("click", closeLightbox);
      lightbox?.addEventListener("click", (event) => {
        const rect = lightbox.getBoundingClientRect();
        const inside = rect.top <= event.clientY && event.clientY <= rect.bottom && rect.left <= event.clientX && event.clientX <= rect.right;
        if (!inside) closeLightbox();
      });

      updateSelectedFilesUI();
      loadPhotos();
      setInterval(loadPhotos, 20000);
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #faf7f2;
    --surface: rgba(255, 255, 255, 0.82);
    --surface-strong: #ffffff;
    --text: #221b18;
    --muted: #6e625c;
    --line: rgba(34, 27, 24, 0.1);
    --accent: #9f6f5a;
    --accent-dark: #7f5644;
    --accent-soft: #efe3db;
    --shadow: 0 20px 60px rgba(70, 44, 34, 0.12);
    --radius: 24px;
  }

  * { box-sizing: border-box; }
  body { margin: 0; font-family: system-ui, sans-serif; background: var(--bg); color: var(--text); }

  .photo-page {
    background: radial-gradient(circle at top, rgba(159,111,90,.12), transparent 30%), var(--bg);
    min-height: 100vh;
    padding: 4rem 1.25rem 6rem;
  }

  .shell {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    gap: 1.5rem;
  }

  .hero, .gallery-section {
    background: var(--surface);
    backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .hero { padding: 2rem; text-align: center; }

  .eyebrow, .panel-kicker, .status-label {
    text-transform: uppercase;
    letter-spacing: .14em;
    font-size: .78rem;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    line-height: 1.02;
    margin: .75rem auto 1rem;
    max-width: 12ch;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.1;
    margin: .35rem 0 .75rem;
  }

  .intro, .message, .photo-meta, .selected-files, .lightbox-caption {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .intro {
    max-width: 620px;
    margin: 0 auto;
  }

  .hero-actions, .section-head, .status-grid {
    display: flex;
    gap: .9rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero-actions, .status-grid {
    justify-content: center;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: .85rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid transparent;
    font-weight: 600;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .btn-primary { background: var(--accent); color: white; }
  .btn-primary:hover { background: var(--accent-dark); }
  .btn-accent { background: var(--accent-soft); border-color: rgba(159,111,90,.24); }
  .btn-secondary, .btn-ghost { border-color: var(--line); }
  .btn:disabled { opacity: .5; cursor: not-allowed; }

  .selected-files {
    margin-top: 1rem;
  }

  .status-card {
    min-width: 155px;
    background: var(--surface-strong);
    border-radius: 18px;
    border: 1px solid var(--line);
    padding: 1rem 1.1rem;
    text-align: left;
  }

  .status-card strong {
    display: block;
    font-size: 1.2rem;
    margin-top: .35rem;
  }

  .gallery-section { padding: 1.4rem; }
  .section-head { justify-content: space-between; margin-bottom: 1rem; }
  .message[data-error="true"] { color: #a04242; }

  .gallery-grid {
    margin-top: 1.1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: .9rem;
  }

  .photo-card {
    overflow: hidden;
    border-radius: 20px;
    background: var(--surface-strong);
    border: 1px solid var(--line);
  }

  .photo-trigger {
    display: block;
    width: 100%;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: zoom-in;
  }

  .photo-card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    display: block;
    background: #efe7df;
  }

  .photo-meta { padding: .8rem .9rem 1rem; font-size: .92rem; }

  .lightbox {
    width: min(92vw, 980px);
    border: 0;
    border-radius: 24px;
    padding: 1rem;
    background: rgba(255,255,255,.98);
    box-shadow: 0 24px 80px rgba(0,0,0,.25);
  }

  .lightbox::backdrop {
    background: rgba(16, 12, 10, .72);
    backdrop-filter: blur(4px);
  }

  .lightbox img {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 16px;
    background: #f3ede8;
  }

  .lightbox-close {
    margin-left: auto;
    display: block;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: white;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-caption {
    margin: .85rem 0 .25rem;
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .photo-page { padding: 1rem .85rem 4rem; }
    .hero { padding: 1.4rem; text-align: left; }
    .hero-actions > *, .section-head > *, .btn { width: 100%; }
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .lightbox {
      width: calc(100vw - 1rem);
      padding: .8rem;
      border-radius: 20px;
    }
  }
</style>
