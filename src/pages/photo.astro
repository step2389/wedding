---
const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Foto matrimonio</title>
  </head>

  <body>
    <main class="photo-page">
      <div class="photo-wrap">

        <section class="photo-box">
          <p class="photo-kicker">Album condiviso</p>
          <h1 class="photo-title">Carica le tue foto del matrimonio</h1>
          <p class="photo-text">
            Puoi scattare una foto al momento oppure scegliere immagini già presenti sul telefono. Poi premi "Carica adesso".
          </p>

          <div class="photo-actions">
            <label for="camera-input" class="photo-btn photo-btn-primary">📷 Scatta una foto</label>
            <label for="gallery-input" class="photo-btn photo-btn-secondary">🖼 Scegli dalla galleria</label>
            <button id="upload-btn" class="photo-btn photo-btn-soft" type="button" disabled>Carica adesso</button>
          </div>

          <input id="camera-input" class="sr-only" type="file" accept="image/*" capture="environment" />
          <input id="gallery-input" class="sr-only" type="file" accept="image/*" multiple />

          <p id="selected-files" class="photo-selected">Nessuna foto selezionata.</p>

          <div class="photo-stats">
            <div class="photo-stat">
              <span>Stato upload</span>
              <strong id="upload-status">Pronto</strong>
            </div>
            <div class="photo-stat">
              <span>Foto visibili</span>
              <strong id="photo-count">—</strong>
            </div>
          </div>
        </section>

        <section class="photo-box">
          <div class="photo-head">
            <div>
              <p class="photo-kicker">Galleria live</p>
              <h2 class="photo-subtitle">Tutte le foto degli invitati</h2>
            </div>
            <button id="refresh-btn" class="photo-btn photo-btn-secondary" type="button">Aggiorna</button>
          </div>

          <p id="message" class="photo-message" role="status" aria-live="polite">
            Sto caricando la galleria...
          </p>

          <div id="gallery-grid" class="photo-grid"></div>
        </section>

      </div>
    </main>

    <script type="module">
      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";

      const cameraInput  = document.getElementById("camera-input");
      const galleryInput = document.getElementById("gallery-input");
      const uploadBtn    = document.getElementById("upload-btn");
      const selText      = document.getElementById("selected-files");
      const grid         = document.getElementById("gallery-grid");
      const msg          = document.getElementById("message");
      const statusEl     = document.getElementById("upload-status");
      const countEl      = document.getElementById("photo-count");
      const refreshBtn   = document.getElementById("refresh-btn");

      let selectedFiles = [];

      function showMsg(text, err = false) {
        msg.textContent = text;
        msg.dataset.error = err ? "true" : "false";
      }

      function updateSelUI() {
        if (!selectedFiles.length) {
          selText.textContent = "Nessuna foto selezionata.";
          uploadBtn.disabled = true;
          return;
        }
        const names = selectedFiles.slice(0, 2).map(f => f.name).join(", ");
        const extra = selectedFiles.length > 2 ? ` +${selectedFiles.length - 2} altre` : "";
        selText.textContent = `${selectedFiles.length} foto: ${names}${extra}`;
        uploadBtn.disabled = false;
      }

      function addFiles(list) {
        const files = Array.from(list || []);
        if (!files.length) return;
        selectedFiles = [...selectedFiles, ...files];
        updateSelUI();
      }

      /* ── card builder ─────────────────────────────────────────── */
      function makeCard(photo) {
        const card = document.createElement("article");
        card.className = "photo-card";

        const link = document.createElement("a");
        link.href = photo.url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.className = "photo-card-link";

        const frame = document.createElement("div");
        frame.className = "photo-card-frame";

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = "Foto degli invitati";
        img.loading = "lazy";
        img.decoding = "async";
        img.className = "photo-card-img";

        const meta = document.createElement("p");
        meta.className = "photo-card-meta";
        const d = photo.uploaded ? new Date(photo.uploaded) : null;
        meta.textContent = d && !isNaN(d)
          ? d.toLocaleString("it-IT", { dateStyle: "short", timeStyle: "short" })
          : "Appena caricata";

        frame.appendChild(img);
        link.appendChild(frame);
        card.appendChild(link);
        card.appendChild(meta);
        return card;
      }

      /* ── load photos ──────────────────────────────────────────── */
      async function loadPhotos() {
        showMsg("Caricamento in corso...");
        try {
          const res = await fetch(`${workerBase}/photos`, { cache: "no-store" });
          if (!res.ok) throw new Error();
          const photos = await res.json();

          grid.innerHTML = "";
          countEl.textContent = String(photos.length);

          if (!photos.length) {
            showMsg("Nessuna foto ancora. Sii il primo a condividere uno scatto!");
            return;
          }

          const frag = document.createDocumentFragment();
          photos.forEach(p => frag.appendChild(makeCard(p)));
          grid.appendChild(frag);
          showMsg(`${photos.length} foto disponibili.`);
        } catch {
          showMsg("Impossibile caricare la galleria.", true);
        }
      }

      /* ── upload ───────────────────────────────────────────────── */
      async function doUpload() {
        if (!selectedFiles.length) return;
        uploadBtn.disabled = true;
        statusEl.textContent = "Caricamento...";
        showMsg(`Carico ${selectedFiles.length} foto...`);

        try {
          const fd = new FormData();
          selectedFiles.forEach(f => fd.append("photos", f));
          const res  = await fetch(`${workerBase}/upload`, { method: "POST", body: fd });
          const data = await res.json();
          if (!res.ok || data.error) throw new Error(data.error || "Upload fallito");

          statusEl.textContent = "Completato ✓";
          const n = data.uploaded?.length || 0;
          const s = data.skipped?.length  || 0;
          showMsg(s ? `${n} caricate, ${s} saltate.` : `${n} foto caricate con successo.`);

          selectedFiles = [];
          cameraInput.value  = "";
          galleryInput.value = "";
          updateSelUI();
          await loadPhotos();
        } catch {
          statusEl.textContent = "Errore";
          showMsg("Upload non riuscito. Riprova.", true);
          uploadBtn.disabled = false;
        }
      }

      cameraInput?.addEventListener("change",  e => addFiles(e.target.files));
      galleryInput?.addEventListener("change", e => addFiles(e.target.files));
      uploadBtn?.addEventListener("click",  doUpload);
      refreshBtn?.addEventListener("click", loadPhotos);

      updateSelUI();
      loadPhotos();
    </script>
  </body>
</html>

<style is:global>
  /* ── reset locale ───────────────────────────────────────────── */
  .photo-page,
  .photo-page *,
  .photo-page *::before,
  .photo-page *::after {
    box-sizing: border-box;
  }

  /* ── layout ─────────────────────────────────────────────────── */
  .photo-page {
    min-height: 100vh;
    padding: 16px 12px 48px;
    background: #faf7f2;
    font-family: system-ui, -apple-system, sans-serif;
    color: #221b18;
  }

  .photo-wrap {
    width: min(100%, 980px);
    margin: 0 auto;
    display: grid;
    gap: 16px;
  }

  .photo-box {
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(34, 27, 24, 0.1);
    border-radius: 24px;
    padding: 20px;
    overflow: hidden;
  }

  /* ── typography ─────────────────────────────────────────────── */
  .photo-kicker {
    margin: 0 0 6px;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #6e625c;
  }

  .photo-title {
    margin: 0 0 12px;
    font-size: clamp(1.9rem, 5vw, 3.4rem);
    line-height: 1.05;
  }

  .photo-subtitle {
    margin: 0 0 12px;
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    line-height: 1.1;
  }

  .photo-text,
  .photo-selected,
  .photo-message {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: #6e625c;
  }

  /* ── buttons ─────────────────────────────────────────────────── */
  .photo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .photo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid rgba(34, 27, 24, 0.12);
    background: #fff;
    color: #221b18;
    font: 600 15px/1 inherit;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .photo-btn-primary  { background: #9f6f5a; border-color: #9f6f5a; color: #fff; }
  .photo-btn-secondary{ border-color: rgba(34,27,24,.15); }
  .photo-btn-soft     { background: #efe3db; border-color: rgba(159,111,90,.2); }
  .photo-btn:disabled { opacity: .5; cursor: not-allowed; }

  .photo-selected { margin-top: 12px; word-break: break-word; }

  /* ── stats ───────────────────────────────────────────────────── */
  .photo-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .photo-stat {
    flex: 1 1 150px;
    background: #fff;
    border: 1px solid rgba(34,27,24,.1);
    border-radius: 16px;
    padding: 14px 16px;
  }

  .photo-stat span   { display: block; font-size: 11px; letter-spacing:.12em; text-transform:uppercase; color:#6e625c; }
  .photo-stat strong { display: block; margin-top: 5px; font-size: 1.15rem; }

  /* ── gallery head ────────────────────────────────────────────── */
  .photo-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }

  .photo-message[data-error="true"] { color: #a04242; }

  /* ── THE GRID ────────────────────────────────────────────────── */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  @media (min-width: 640px)  { .photo-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .photo-grid { grid-template-columns: repeat(4, 1fr); } }

  /* ── THE CARD ────────────────────────────────────────────────── */
  .photo-card {
    display: block;
    min-width: 0;
    overflow: hidden;
    border-radius: 16px;
    background: #fff;
    border: 1px solid rgba(34,27,24,.08);
  }

  .photo-card-link {
    display: block;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* contenitore con altezza fissa → l'immagine NON può sfondare */
  .photo-card-frame {
    position: relative;
    width: 100%;
    padding-top: 125%; /* aspect ratio 4:5 */
    overflow: hidden;
    background: #e8dfd7;
  }

  /* l'immagine riempie il frame al 100%, ritagliata */
  .photo-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .photo-card-meta {
    margin: 0;
    padding: 8px 12px 12px;
    font-size: 13px;
    color: #6e625c;
    line-height: 1.4;
  }

  /* ── mobile tweaks ───────────────────────────────────────────── */
  @media (max-width: 600px) {
    .photo-btn { width: 100%; }
    .photo-head .photo-btn { width: auto; }
  }

  /* ── sr-only ─────────────────────────────────────────────────── */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
</style>
