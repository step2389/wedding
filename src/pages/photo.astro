---
const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Foto matrimonio</title>
    <style>
      html, body {
        margin: 0;
        padding: 0;
        background: #faf7f2;
      }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #221b18;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      .photo-page {
        min-height: 100vh;
        padding: 14px 10px 40px;
        background: #faf7f2;
      }

      .photo-wrap {
        width: min(100%, 980px);
        margin: 0 auto;
      }

      .photo-box {
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid rgba(34, 27, 24, 0.1);
        border-radius: 24px;
        padding: 18px;
        margin-bottom: 16px;
        overflow: hidden;
      }

      .photo-kicker {
        margin: 0 0 6px;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #6e625c;
      }

      .photo-title,
      .photo-subtitle {
        margin: 0 0 10px;
        line-height: 1.05;
        font-family: Georgia, "Times New Roman", serif;
      }

      .photo-title {
        font-size: clamp(2rem, 5vw, 3.6rem);
      }

      .photo-subtitle {
        font-size: clamp(1.45rem, 3.2vw, 2rem);
      }

      .photo-text,
      .photo-message,
      .photo-selected,
      .photo-meta {
        margin: 0;
        color: #6e625c;
        line-height: 1.6;
        font-size: 16px;
      }

      .photo-actions,
      .photo-stats,
      .photo-head {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
      }

      .photo-actions,
      .photo-stats {
        margin-top: 16px;
      }

      .photo-head {
        justify-content: space-between;
        margin-bottom: 14px;
      }

      .photo-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 12px 18px;
        border-radius: 999px;
        border: 1px solid rgba(34, 27, 24, 0.1);
        background: #fff;
        color: #221b18;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
      }

      .photo-btn-primary {
        background: #9f6f5a;
        border-color: #9f6f5a;
        color: #fff;
      }

      .photo-btn-soft {
        background: #efe3db;
        border-color: rgba(159, 111, 90, 0.2);
      }

      .photo-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .photo-selected {
        margin-top: 12px;
        word-break: break-word;
      }

      .photo-stat {
        flex: 1 1 160px;
        min-width: 0;
        background: #fff;
        border: 1px solid rgba(34, 27, 24, 0.1);
        border-radius: 18px;
        padding: 14px 16px;
      }

      .photo-stat span {
        display: block;
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #6e625c;
      }

      .photo-stat strong {
        display: block;
        margin-top: 6px;
        font-size: 1.15rem;
      }

      .photo-message[data-error="true"] {
        color: #a04242;
      }

      .photo-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        width: 100%;
        margin-top: 14px;
      }

      .photo-card {
        width: 100%;
        min-width: 0;
        overflow: hidden;
        border-radius: 18px;
        background: #fff;
        border: 1px solid rgba(34, 27, 24, 0.1);
      }

      .photo-link {
        display: block;
        width: 100%;
        text-decoration: none;
        color: inherit;
      }

      .photo-media {
        width: 100%;
        height: 240px;
        overflow: hidden;
        background: #ece5dd;
      }

      .photo-media img {
        display: block;
        width: 100%;
        height: 240px;
        object-fit: cover;
        object-position: center;
      }

      .photo-meta {
        padding: 10px 12px 12px;
        font-size: 14px;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
        border: 0;
      }

      @media (min-width: 700px) {
        .photo-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (min-width: 1024px) {
        .photo-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 760px) {
        .photo-actions > *,
        .photo-head > *,
        .photo-btn {
          width: 100%;
        }
      }
    </style>
  </head>

  <body>
    <main class="photo-page">
      <div class="photo-wrap">
        <section class="photo-box">
          <p class="photo-kicker">Album condiviso</p>
          <h1 class="photo-title">Carica le tue foto del matrimonio</h1>
          <p class="photo-text">
            Puoi scattare una foto al momento oppure scegliere immagini già presenti sul telefono.
          </p>

          <div class="photo-actions">
            <label for="camera-input" class="photo-btn photo-btn-primary">Scatta una foto</label>
            <label for="gallery-input" class="photo-btn">Scegli dalla galleria</label>
            <button id="upload-btn" class="photo-btn photo-btn-soft" type="button" disabled>Carica adesso</button>
          </div>

          <input id="camera-input" class="sr-only" type="file" accept="image/*" capture="environment" />
          <input id="gallery-input" class="sr-only" type="file" accept="image/*" multiple />

          <p id="selected-files" class="photo-selected">Nessuna foto selezionata.</p>

          <div class="photo-stats">
            <div class="photo-stat">
              <span>Stato upload</span>
              <strong id="upload-status">Pronto</strong>
            </div>
            <div class="photo-stat">
              <span>Foto visibili</span>
              <strong id="photo-count">0</strong>
            </div>
          </div>
        </section>

        <section class="photo-box">
          <div class="photo-head">
            <div>
              <p class="photo-kicker">Galleria live</p>
              <h2 class="photo-subtitle">Tutte le foto degli invitati</h2>
            </div>
            <button id="refresh-btn" class="photo-btn" type="button">Aggiorna</button>
          </div>

          <p id="message" class="photo-message" role="status" aria-live="polite">Sto caricando la galleria...</p>
          <div id="gallery-grid" class="photo-grid"></div>
        </section>
      </div>
    </main>

    <script type="module">
      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";

      const cameraInput = document.getElementById("camera-input");
      const galleryInput = document.getElementById("gallery-input");
      const uploadBtn = document.getElementById("upload-btn");
      const selectedFilesText = document.getElementById("selected-files");
      const gallery = document.getElementById("gallery-grid");
      const message = document.getElementById("message");
      const uploadStatus = document.getElementById("upload-status");
      const photoCount = document.getElementById("photo-count");
      const refreshBtn = document.getElementById("refresh-btn");

      let selectedFiles = [];

      function showMessage(text, isError = false) {
        message.textContent = text;
        message.dataset.error = isError ? "true" : "false";
      }

      function updateSelectedFilesUI() {
        if (!selectedFiles.length) {
          selectedFilesText.textContent = "Nessuna foto selezionata.";
          uploadBtn.disabled = true;
          return;
        }

        const names = selectedFiles.slice(0, 2).map((file) => file.name).join(", ");
        const extra = selectedFiles.length > 2 ? ` +${selectedFiles.length - 2} altre` : "";
        selectedFilesText.textContent = `${selectedFiles.length} foto selezionate: ${names}${extra}`;
        uploadBtn.disabled = false;
      }

      function addFiles(fileList) {
        const files = Array.from(fileList || []);
        if (!files.length) return;
        selectedFiles = [...selectedFiles, ...files];
        updateSelectedFilesUI();
      }

      function createPhotoCard(photo) {
        const card = document.createElement("article");
        card.className = "photo-card";

        const link = document.createElement("a");
        link.href = photo.url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.className = "photo-link";

        const media = document.createElement("div");
        media.className = "photo-media";

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = "Foto caricata dagli invitati";
        img.loading = "lazy";
        img.decoding = "async";

        media.appendChild(img);
        link.appendChild(media);

        const meta = document.createElement("div");
        meta.className = "photo-meta";

        const date = photo.uploaded ? new Date(photo.uploaded) : null;
        meta.textContent =
          date && !Number.isNaN(date.getTime())
            ? date.toLocaleString("it-IT", { dateStyle: "short", timeStyle: "short" })
            : "Appena caricata";

        card.append(link, meta);
        return card;
      }

      async function loadPhotos() {
        try {
          showMessage("Sto caricando la galleria...");
          const res = await fetch(`${workerBase}/photos`, { cache: "no-store" });
          if (!res.ok) throw new Error("Errore");
          const photos = await res.json();

          gallery.innerHTML = "";
          photoCount.textContent = String(photos.length);

          if (!photos.length) {
            showMessage("Nessuna foto caricata per ora.");
            return;
          }

          const frag = document.createDocumentFragment();
          photos.forEach((photo) => frag.appendChild(createPhotoCard(photo)));
          gallery.appendChild(frag);
          showMessage(`Galleria aggiornata: ${photos.length} foto disponibili.`);
        } catch {
          showMessage("Non riesco a caricare la galleria.", true);
        }
      }

      async function uploadFiles() {
        if (!selectedFiles.length) return;

        uploadBtn.disabled = true;
        uploadStatus.textContent = "Caricamento...";
        showMessage(`Sto caricando ${selectedFiles.length} foto...`);

        try {
          const fd = new FormData();
          selectedFiles.forEach((file) => fd.append("photos", file));

          const res = await fetch(`${workerBase}/upload`, {
            method: "POST",
            body: fd
          });

          const data = await res.json();
          if (!res.ok || data.error) throw new Error(data.error || "Upload fallito");

          uploadStatus.textContent = "Completato";
          selectedFiles = [];
          cameraInput.value = "";
          galleryInput.value = "";
          updateSelectedFilesUI();
          await loadPhotos();
        } catch {
          uploadStatus.textContent = "Errore";
          showMessage("Upload non riuscito. Riprova.", true);
          uploadBtn.disabled = false;
        }
      }

      cameraInput?.addEventListener("change", (event) => addFiles(event.target.files));
      galleryInput?.addEventListener("change", (event) => addFiles(event.target.files));
      uploadBtn?.addEventListener("click", uploadFiles);
      refreshBtn?.addEventListener("click", loadPhotos);

      updateSelectedFilesUI();
      loadPhotos();
    </script>
  </body>
</html>