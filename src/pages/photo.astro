---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>Galleria Matrimonio Anna & Stefano</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,400&family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="photo-page font-montserrat">
      <section class="gallery-shell" aria-label="I vostri scatti">
        <header class="gallery-topbar">
          <div class="gallery-topbar-inner">
            <a href="/" class="brand-link" title="Torna alla Home">
              <span class="gallery-subtitle">A & S</span>
            </a>

            <div class="gallery-tools">
              <div class="gallery-count-badge" title="Foto totali">
                <svg class="count-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
                <span
                  id="photo-count"
                  class="gallery-count"
                  aria-label="Numero totale foto">0</span
                >
                <span
                  id="new-dot"
                  class="new-dot"
                  hidden
                  aria-label="Nuove foto disponibili"></span>
              </div>
            </div>
          </div>
        </header>

        <p
          id="message"
          class="gallery-message"
          role="status"
          aria-live="polite"
        >
        </p>

        <p class="gallery-tagline">
          Condividi un ricordo speciale di questa giornata!
        </p>

        <div class="gallery-grid-wrap">
          <div id="gallery-grid" class="gallery-grid"></div>
        </div>

        <div class="gallery-actions">
          <button id="load-more-btn" class="load-more-btn" type="button" hidden
            >Carica altre foto</button
          >
        </div>
      </section>

      <div class="upload-dock-wrap">
        <section class="upload-dock" aria-label="Carica nuove foto">
          <input
            id="camera-input"
            class="sr-only"
            type="file"
            accept="image/*"
            capture="environment"
          />
          <input
            id="gallery-input"
            class="sr-only"
            type="file"
            accept="image/*"
            multiple
          />

          <label
            for="camera-input"
            class="dock-action dock-action-secondary"
            title="Scatta foto con fotocamera"
          >
            <span class="dock-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                ></path>
                <circle cx="12" cy="13" r="4"></circle>
                <circle cx="18.5" cy="9.5" r="0.8" fill="currentColor"></circle>
              </svg>
            </span>
            <span class="dock-copy">
              <span class="dock-label">Fotocamera</span>
              <span class="dock-sub">Scatta ora</span>
            </span>
          </label>

          <label
            for="gallery-input"
            class="dock-action dock-action-secondary"
            title="Scegli dalla galleria"
          >
            <span class="dock-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="3" width="18" height="18" rx="4"></rect>
                <circle
                  cx="8.5"
                  cy="8.5"
                  r="1.5"
                  fill="currentColor"
                  opacity="0.4"></circle>
                <path d="M21 15l-5-5L5 21"></path>
                <path d="M14 14l2.5-2.5L21 16"></path>
              </svg>
            </span>
            <span class="dock-copy">
              <span class="dock-label">Galleria</span>
              <span class="dock-sub">Seleziona</span>
            </span>
          </label>

          <button
            id="upload-btn"
            class="dock-action dock-action-primary"
            type="button"
            disabled
            title="Invia foto selezionate"
          >
            <span class="dock-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"
                ></path>
                <path d="M12 12v9"></path>
                <path d="m16 16-4-4-4 4"></path>
              </svg>
            </span>
            <span class="dock-copy dock-copy-primary">
              <span id="upload-label" class="dock-label dock-label-strong"
                >Invia foto</span
              >
              <span id="upload-sub" class="dock-sub dock-sub-primary"
                >Seleziona prima</span
              >
            </span>
            <span id="upload-count" class="dock-badge" hidden>0</span>
          </button>
        </section>
      </div>
    </main>

    <div class="photo-footer-wrap">
      <Footer />
    </div>

    <dialog id="lightbox" class="photo-lightbox" aria-label="Foto ingrandita">
      <div class="photo-lightbox-inner">
        <button
          id="lightbox-close"
          class="photo-lightbox-close"
          type="button"
          aria-label="Chiudi immagine"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              d="M18 6L6 18M6 6l12 12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </button>

        <button
          id="lightbox-prev"
          class="photo-lightbox-nav prev"
          type="button"
          aria-label="Foto precedente"
          title="Foto precedente"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>

        <button
          id="lightbox-next"
          class="photo-lightbox-nav next"
          type="button"
          aria-label="Foto successiva"
          title="Foto successiva"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 18l6-6-6-6"></path>
          </svg>
        </button>

        <div class="photo-lightbox-media">
          <img
            id="lightbox-image"
            class="photo-lightbox-image"
            alt="Foto ingrandita"
          />
        </div>

        <div class="photo-lightbox-toolbar">
          <p id="lightbox-caption" class="photo-lightbox-caption"></p>

          <div class="photo-lightbox-actions">
            <a
              id="lightbox-download"
              class="lightbox-action-btn"
              href="#"
              target="_blank"
              download
              title="Scarica foto sul dispositivo"
            >
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Scarica</span>
            </a>

            <button
              id="lightbox-share"
              class="lightbox-action-btn"
              type="button"
              title="Condividi foto"
            >
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <span>Condividi</span>
            </button>
          </div>
        </div>
      </div>
    </dialog>

    <script type="module">
      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
      const MAX_FILES = 20;
      const MAX_FILE_SIZE = 10 * 1024 * 1024;
      const BATCH_SIZE = 24;

      const cameraInput = document.getElementById("camera-input");
      const galleryInput = document.getElementById("gallery-input");
      const uploadBtn = document.getElementById("upload-btn");
      const uploadLabel = document.getElementById("upload-label");
      const uploadSub = document.getElementById("upload-sub");
      const uploadCount = document.getElementById("upload-count");
      const loadMoreBtn = document.getElementById("load-more-btn");
      const gallery = document.getElementById("gallery-grid");
      const message = document.getElementById("message");
      const photoCount = document.getElementById("photo-count");
      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxCaption = document.getElementById("lightbox-caption");
      const lightboxClose = document.getElementById("lightbox-close");
      const lightboxPrev = document.getElementById("lightbox-prev");
      const lightboxNext = document.getElementById("lightbox-next");
      const lightboxDownload = document.getElementById("lightbox-download");
      const lightboxShare = document.getElementById("lightbox-share");

      let selectedFiles = [];
      let isUploading = false;
      let isLoadingMore = false;
      let allPhotos = [];
      let renderedCount = 0;
      let currentPhotoIndex = -1;

      function showMessage(text = "", isError = false) {
        message.textContent = text;
        message.dataset.error = isError ? "true" : "false";
        message.hidden = !text;
      }

      function setUploadingState(nextUploading) {
        isUploading = nextUploading;
        cameraInput.disabled = nextUploading;
        galleryInput.disabled = nextUploading;
        uploadBtn.disabled = nextUploading || !selectedFiles.length;
      }

      function updateSelectedFilesUI() {
        const count = selectedFiles.length;

        if (!count) {
          uploadLabel.textContent = "Invia foto";
          uploadSub.textContent = "Seleziona prima";
          uploadCount.hidden = true;
          uploadBtn.disabled = true;
          uploadBtn.dataset.hasFiles = "false";
          return;
        }

        uploadSub.textContent =
          count === 1 ? "1 selezionata" : `${count} selezionate`;
        uploadCount.textContent = String(count);
        uploadCount.hidden = false;
        uploadBtn.dataset.hasFiles = "true";
        uploadBtn.disabled = isUploading;
      }

      function normalizeFiles(fileList) {
        return Array.from(fileList || []).filter(
          (file) =>
            file.type.startsWith("image/") && file.size <= MAX_FILE_SIZE,
        );
      }

      function addFiles(fileList) {
        const validFiles = normalizeFiles(fileList);

        if (!validFiles.length) {
          showMessage("Seleziona immagini valide fino a 10 MB.", true);
          return;
        }

        selectedFiles = [...selectedFiles, ...validFiles].slice(0, MAX_FILES);
        updateSelectedFilesUI();
        showMessage("");
      }

      function formatUploadedLabel(uploaded) {
        const date = uploaded ? new Date(uploaded) : null;
        return date && !Number.isNaN(date.getTime())
          ? date.toLocaleString("it-IT", {
              dateStyle: "short",
              timeStyle: "short",
            })
          : "Appena caricata";
      }

      function openLightbox(url, caption = "", index = -1) {
        currentPhotoIndex = index;
        lightboxImage.src = url;
        lightboxCaption.textContent = caption;

        if (lightboxDownload) {
          lightboxDownload.href = url;
        }

        if (lightboxPrev) {
          lightboxPrev.style.display = index > 0 ? "flex" : "none";
        }
        if (lightboxNext) {
          lightboxNext.style.display =
            index >= 0 && index < allPhotos.length - 1 ? "flex" : "none";
        }

        if (!lightbox.open) lightbox.showModal();
      }

      function closeLightbox() {
        if (lightbox.open) lightbox.close();
        lightboxImage.src = "";
        lightboxCaption.textContent = "";
        currentPhotoIndex = -1;
      }

      function navigateLightbox(direction) {
        if (currentPhotoIndex < 0 || !allPhotos.length) return;
        const targetIndex = currentPhotoIndex + direction;
        if (targetIndex >= 0 && targetIndex < allPhotos.length) {
          const photo = allPhotos[targetIndex];
          const uploadedLabel = formatUploadedLabel(photo.uploaded);
          openLightbox(photo.url, uploadedLabel, targetIndex);
        }
      }

      async function downloadPhoto(event) {
        if (event) event.preventDefault();
        if (!lightboxImage.src) return;
        const photoUrl = lightboxImage.src;
        // Usa il proxy Worker per bypassare il blocco CORS di photo.penz23.org
        const proxyUrl = `${workerBase}/photo/${new URL(photoUrl).pathname.slice(1)}`;
        const btnSpan = lightboxDownload?.querySelector("span");
        const originalText = btnSpan ? btnSpan.textContent : "Scarica";
        if (btnSpan) btnSpan.textContent = "Salvataggio...";

        try {
          const response = await fetch(proxyUrl);
          if (!response.ok) throw new Error("fetch fallito");
          const blob = await response.blob();
          const localUrl = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = localUrl;
          a.download = `foto-matrimonio-anna-stefano-${currentPhotoIndex >= 0 ? currentPhotoIndex + 1 : "foto"}.jpg`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(localUrl), 3000);
          showMessage("Foto salvata nel dispositivo! ✓", false);
          setTimeout(() => showMessage(""), 3000);
        } catch {
          window.open(photoUrl, "_blank");
          showMessage("Tieni premuto sulla foto per salvarla!", false);
          setTimeout(() => showMessage(""), 4000);
        } finally {
          if (btnSpan) btnSpan.textContent = originalText;
        }
      }

      async function sharePhoto() {
        if (!lightboxImage.src) return;
        const photoUrl = lightboxImage.src;
        // Usa il proxy Worker per bypassare il blocco CORS di photo.penz23.org
        const proxyUrl = `${workerBase}/photo/${new URL(photoUrl).pathname.slice(1)}`;
        const btnSpan = lightboxShare?.querySelector("span");
        const originalText = btnSpan ? btnSpan.textContent : "Condividi";
        if (btnSpan) btnSpan.textContent = "Preparazione...";

        try {
          const response = await fetch(proxyUrl);
          if (!response.ok) throw new Error("fetch fallito");
          const blob = await response.blob();
          const file = new File(
            [blob],
            `foto-matrimonio-${currentPhotoIndex >= 0 ? currentPhotoIndex + 1 : "foto"}.jpg`,
            { type: "image/jpeg" },
          );

          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({
              title: "Foto Matrimonio Anna & Stefano",
              text: "Guarda questa foto del matrimonio di Anna & Stefano!",
              files: [file],
            });
          } else if (navigator.share) {
            await navigator.share({
              title: "Foto Matrimonio Anna & Stefano",
              text: "Guarda questa foto del matrimonio di Anna & Stefano!",
              url: photoUrl,
            });
          } else {
            await navigator.clipboard.writeText(photoUrl);
            showMessage("Link della foto copiato negli appunti!", false);
            setTimeout(() => showMessage(""), 3500);
          }
        } catch (err) {
          if (err.name === "AbortError") return;
          // Fallback: condivisione URL nativa senza file allegato
          if (navigator.share) {
            try {
              await navigator.share({
                title: "Foto Matrimonio Anna & Stefano",
                url: photoUrl,
              });
            } catch {
              /* annullato */
            }
          }
        } finally {
          if (btnSpan) btnSpan.textContent = originalText;
        }
      }

      function createPhotoCard(photo, index) {
        const card = document.createElement("article");
        card.className = "gallery-item";

        const button = document.createElement("button");
        button.type = "button";
        button.className = "gallery-item-button";

        const uploadedLabel = formatUploadedLabel(photo.uploaded);
        button.setAttribute(
          "aria-label",
          `Apri foto ${index + 1}, caricata ${uploadedLabel}`,
        );
        button.addEventListener("click", () =>
          openLightbox(photo.url, uploadedLabel, index),
        );

        const imageWrap = document.createElement("div");
        imageWrap.className = "gallery-image-wrap";

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = `Foto caricata ${uploadedLabel}`;
        img.loading = "lazy";
        img.decoding = "async";
        img.setAttribute("fetchpriority", "low");
        img.addEventListener("load", () => img.classList.add("loaded"));

        imageWrap.appendChild(img);
        button.appendChild(imageWrap);
        card.appendChild(button);
        return card;
      }

      function updatePhotoCount() {
        photoCount.textContent = String(allPhotos.length);
      }

      function updateLoadMoreVisibility() {
        const isFinished = renderedCount >= allPhotos.length;
        loadMoreBtn.hidden = isFinished;
        if (!isFinished) {
          loadMoreBtn.textContent = `Carica altre foto (${renderedCount} di ${allPhotos.length})`;
        }
      }

      function appendNextBatch() {
        if (isLoadingMore) return;
        if (renderedCount >= allPhotos.length) {
          updateLoadMoreVisibility();
          return;
        }

        isLoadingMore = true;
        loadMoreBtn.disabled = true;

        const nextChunk = allPhotos.slice(
          renderedCount,
          renderedCount + BATCH_SIZE,
        );
        const fragment = document.createDocumentFragment();

        nextChunk.forEach((photo, index) => {
          fragment.appendChild(createPhotoCard(photo, renderedCount + index));
        });

        requestAnimationFrame(() => {
          gallery.appendChild(fragment);
          renderedCount += nextChunk.length;
          updateLoadMoreVisibility();
          isLoadingMore = false;
          loadMoreBtn.disabled = false;
        });
      }

      function resetFeed() {
        gallery.innerHTML = "";
        renderedCount = 0;
        appendNextBatch();
      }

      async function fetchAllPhotos() {
        const response = await fetch(`${workerBase}/photos`, {
          cache: "no-store",
        });
        if (!response.ok) throw new Error("Errore nel caricamento galleria");
        const data = await response.json();
        return Array.isArray(data) ? data : [];
      }

      async function loadInitialPhotos() {
        try {
          showMessage("");
          allPhotos = await fetchAllPhotos();
          updatePhotoCount();

          if (!allPhotos.length) {
            gallery.innerHTML = `
              <div class="empty-gallery-state">
                <svg class="empty-icon" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <p class="empty-title">Ancora nessuna foto</p>
                <p class="empty-sub">Condividi per primo un ricordo speciale di questa giornata!</p>
              </div>
            `;
            loadMoreBtn.hidden = true;
            return;
          }

          resetFeed();
        } catch {
          showMessage("Non riesco a caricare la galleria.", true);
        }
      }

      function setupInfiniteScroll() {
        if (!("IntersectionObserver" in window)) return;
        const observer = new IntersectionObserver(
          (entries) => {
            if (
              entries[0].isIntersecting &&
              !isLoadingMore &&
              renderedCount < allPhotos.length &&
              document.visibilityState === "visible"
            ) {
              appendNextBatch();
            }
          },
          { rootMargin: "400px" },
        );
        observer.observe(loadMoreBtn);
      }

      // ── Auto-refresh polling ─────────────────────────────────────────────
      const POLL_INTERVAL_MS = 60_000; // 1 minuto
      let pollTimer = null;

      function showNewDot() {
        const dot = document.getElementById("new-dot");
        if (!dot) return;
        dot.hidden = false;
        // Nasconde il pallino dopo 10 secondi o al primo scroll
        const hide = () => {
          dot.hidden = true;
          window.removeEventListener("scroll", hide, { capture: true });
        };
        setTimeout(hide, 10_000);
        window.addEventListener("scroll", hide, { once: true, capture: true });
      }

      async function pollForNewPhotos() {
        // Non fare polling se la tab è in background
        if (document.visibilityState !== "visible") return;
        // Non fare polling durante un upload attivo
        if (isUploading) return;

        try {
          const fresh = await fetchAllPhotos();
          if (fresh.length > allPhotos.length) {
            const newCount = fresh.length - allPhotos.length;
            // Trova le foto nuove (quelle non già presenti per URL)
            const existingUrls = new Set(allPhotos.map((p) => p.url));
            const newPhotos = fresh.filter((p) => !existingUrls.has(p.url));

            // Prepend in cima alla griglia senza resettare tutto
            const fragment = document.createDocumentFragment();
            newPhotos.forEach((photo, i) => {
              fragment.appendChild(createPhotoCard(photo, i));
            });
            gallery.prepend(fragment);

            // Ricalibra gli indici lightbox
            allPhotos = fresh;
            renderedCount = renderedCount + newPhotos.length;
            updatePhotoCount();
            showNewDot();
          }
        } catch {
          // Silenzioso: non disturbare l'utente per errori di poll
        }
      }

      function startPolling() {
        if (pollTimer) clearInterval(pollTimer);
        pollTimer = setInterval(pollForNewPhotos, POLL_INTERVAL_MS);
      }

      function stopPolling() {
        if (pollTimer) {
          clearInterval(pollTimer);
          pollTimer = null;
        }
      }

      // Pausa il poll quando la tab va in background, riprende quando torna visibile
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") {
          // Controlla subito al ritorno in primo piano, poi riprende il timer
          pollForNewPhotos();
          startPolling();
        } else {
          stopPolling();
        }
      });

      async function uploadFiles() {
        if (!selectedFiles.length || isUploading) return;

        setUploadingState(true);
        uploadSub.textContent = "Invio in corso...";
        uploadCount.hidden = true;
        showMessage("Sto inviando le foto...");

        try {
          const fd = new FormData();
          selectedFiles.forEach((file) => fd.append("photos", file));

          const res = await fetch(`${workerBase}/upload`, {
            method: "POST",
            body: fd,
          });

          let data;
          try {
            data = await res.json();
          } catch {
            throw new Error("Risposta server non valida");
          }

          if (!res.ok || data?.error) {
            throw new Error(data?.error || "Upload fallito");
          }

          selectedFiles = [];
          cameraInput.value = "";
          galleryInput.value = "";
          updateSelectedFilesUI();
          await loadInitialPhotos();
          showMessage("Foto inviate correttamente.", false);
        } catch {
          showMessage("Invio non riuscito. Riprova.", true);
          updateSelectedFilesUI();
        } finally {
          setUploadingState(false);
        }
      }

      cameraInput?.addEventListener("change", (event) =>
        addFiles(event.target.files),
      );
      galleryInput?.addEventListener("change", (event) =>
        addFiles(event.target.files),
      );
      uploadBtn?.addEventListener("click", uploadFiles);
      loadMoreBtn?.addEventListener("click", appendNextBatch);
      lightboxClose?.addEventListener("click", closeLightbox);
      lightboxPrev?.addEventListener("click", () => navigateLightbox(-1));
      lightboxNext?.addEventListener("click", () => navigateLightbox(1));
      lightboxShare?.addEventListener("click", sharePhoto);
      lightboxDownload?.addEventListener("click", downloadPhoto);

      window.addEventListener("keydown", (event) => {
        if (!lightbox?.open) return;
        if (event.key === "ArrowLeft") navigateLightbox(-1);
        if (event.key === "ArrowRight") navigateLightbox(1);
      });

      // Swipe per Smartphone
      let touchStartX = 0;
      let touchEndX = 0;
      lightbox?.addEventListener(
        "touchstart",
        (e) => {
          touchStartX = e.changedTouches[0].screenX;
        },
        { passive: true },
      );

      lightbox?.addEventListener(
        "touchend",
        (e) => {
          touchEndX = e.changedTouches[0].screenX;
          const diffX = touchEndX - touchStartX;
          if (Math.abs(diffX) > 45) {
            if (diffX < 0) navigateLightbox(1);
            else navigateLightbox(-1);
          }
        },
        { passive: true },
      );

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      lightbox?.addEventListener("cancel", () => closeLightbox());
      lightbox?.addEventListener("close", () => closeLightbox());

      updateSelectedFilesUI();
      await loadInitialPhotos();
      setupInfiniteScroll();
      startPolling();

      // ── Header colore dinamico in base allo scroll ────────────────────────
      // Il gradiente CSS è linear-gradient(135deg, #f2e9e1 30%, #b9d8eb 100%)
      // Per 135deg: t = (x + y) / (W + H)  →  formula esatta CSS
      const topbarEl = document.querySelector(".gallery-topbar");
      const colorTop = { r: 242, g: 233, b: 225 }; // #f2e9e1 sabbia
      const colorBot = { r: 185, g: 216, b: 235 }; // #b9d8eb azzurro

      function lerp(a, b, t) {
        return Math.round(a + (b - a) * t);
      }

      function updateHeaderColor() {
        if (!topbarEl) return;
        const W = document.documentElement.clientWidth;
        const H = document.documentElement.scrollHeight;
        if (W + H === 0) return;

        // Punto centrale della header nella coordinata della pagina
        const centerX = W / 2;
        const y = window.scrollY;

        // t lungo il gradiente 135deg (formula esatta per CSS linear-gradient)
        let t = (centerX + y) / (W + H);
        t = Math.min(1, Math.max(0, t));

        // I color-stop sono: sabbia al 30%, azzurro al 100%
        // Rimappo t nei color-stop del gradiente
        let colorT;
        if (t <= 0.3) {
          colorT = 0; // prima del primo stop → colore pieno sabbia
        } else {
          colorT = (t - 0.3) / 0.7;
        }
        colorT = Math.min(1, Math.max(0, colorT));

        const r = lerp(colorTop.r, colorBot.r, colorT);
        const g = lerp(colorTop.g, colorBot.g, colorT);
        const b = lerp(colorTop.b, colorBot.b, colorT);
        topbarEl.style.background = `rgb(${r}, ${g}, ${b})`;
      }

      window.addEventListener("scroll", updateHeaderColor, { passive: true });
      updateHeaderColor(); // imposta colore iniziale
    </script>
  </body>
</html>

