<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Foto matrimonio</title>
  </head>
  <body>
    <main class="photo-page">
      <div class="photo-wrap">
        <section class="photo-box photo-box-upload">
          <h2 >Carica le tue foto del matrimonio</h2>
         

          <div class="photo-actions">
            <label for="camera-input" class="photo-btn photo-btn-primary">Scatta una foto</label>
            <label for="gallery-input" class="photo-btn photo-btn-secondary">Scegli dalla galleria</label>
            <button id="upload-btn" class="photo-btn photo-btn-soft" type="button" disabled>Carica adesso</button>
          </div>

          <input id="camera-input" class="sr-only" type="file" accept="image/*" capture="environment" />
          <input id="gallery-input" class="sr-only" type="file" accept="image/*" multiple />

          <p id="selected-files" class="photo-selected">Nessuna foto selezionata.</p>
        </section>

        <section class="photo-box photo-box-gallery">
          <div class="photo-head photo-head-gallery">
            <p class="photo-kicker photo-kicker-inline">Galleria live</p>
            <div class="photo-gallery-tools">
              <span id="photo-count" class="photo-count-badge" aria-label="Numero foto visibili">0</span>
              <button id="refresh-btn" class="photo-refresh-icon" type="button" aria-label="Aggiorna galleria" title="Aggiorna galleria">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                  <path d="M21 3v6h-6" />
                </svg>
              </button>
            </div>
          </div>

          <p id="message" class="photo-message" role="status" aria-live="polite"></p>
          <div id="gallery-grid" class="photo-grid"></div>
          <div id="gallery-pagination" class="photo-pagination" aria-label="Pagine galleria"></div>
        </section>
      </div>
    </main>

    <dialog id="lightbox" class="photo-lightbox" aria-label="Foto ingrandita">
      <div class="photo-lightbox-inner">
        <button id="lightbox-close" class="photo-lightbox-close" type="button" aria-label="Chiudi immagine">Chiudi</button>
        <img id="lightbox-image" class="photo-lightbox-image" alt="Foto ingrandita" />
        <p id="lightbox-caption" class="photo-lightbox-caption"></p>
      </div>
    </dialog>

    <script type="module">
      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
      const MAX_FILES = 20;
      const MAX_FILE_SIZE = 10 * 1024 * 1024;
      const PHOTOS_PER_PAGE = 20;

      const cameraInput = document.getElementById("camera-input");
      const galleryInput = document.getElementById("gallery-input");
      const uploadBtn = document.getElementById("upload-btn");
      const refreshBtn = document.getElementById("refresh-btn");
      const selectedFilesText = document.getElementById("selected-files");
      const gallery = document.getElementById("gallery-grid");
      const pagination = document.getElementById("gallery-pagination");
      const message = document.getElementById("message");
      const photoCount = document.getElementById("photo-count");
      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxCaption = document.getElementById("lightbox-caption");
      const lightboxClose = document.getElementById("lightbox-close");

      let selectedFiles = [];
      let isUploading = false;
      let allPhotos = [];
      let currentPage = 1;

      function showMessage(text = "", isError = false) {
        message.textContent = text;
        message.dataset.error = isError ? "true" : "false";
        message.hidden = !text;
      }

      function setUploadingState(nextUploading) {
        isUploading = nextUploading;
        cameraInput.disabled = nextUploading;
        galleryInput.disabled = nextUploading;
        refreshBtn.disabled = nextUploading;
        uploadBtn.disabled = nextUploading || !selectedFiles.length;
      }

      function updateSelectedFilesUI() {
        if (!selectedFiles.length) {
          selectedFilesText.textContent = "Nessuna foto selezionata.";
          uploadBtn.disabled = true;
          return;
        }

        const names = selectedFiles.slice(0, 3).map((file) => file.name).join(", ");
        const extra = selectedFiles.length > 3 ? ` +${selectedFiles.length - 3} altre` : "";
        selectedFilesText.textContent = `${selectedFiles.length} foto selezionate: ${names}${extra}`;
        uploadBtn.disabled = isUploading;
      }

      function normalizeFiles(fileList) {
        return Array.from(fileList || []).filter((file) => file.type.startsWith("image/") && file.size <= MAX_FILE_SIZE);
      }

      function addFiles(fileList) {
        const validFiles = normalizeFiles(fileList);

        if (!validFiles.length) {
          showMessage("Seleziona immagini valide fino a 10 MB.", true);
          return;
        }

        selectedFiles = [...selectedFiles, ...validFiles].slice(0, MAX_FILES);
        updateSelectedFilesUI();
        showMessage("");
      }

      function formatUploadedLabel(uploaded) {
        const date = uploaded ? new Date(uploaded) : null;
        return date && !Number.isNaN(date.getTime())
          ? date.toLocaleString("it-IT", { dateStyle: "short", timeStyle: "short" })
          : "Appena caricata";
      }

      function openLightbox(url, caption = "") {
        lightboxImage.src = url;
        lightboxCaption.textContent = caption;
        if (!lightbox.open) lightbox.showModal();
      }

      function closeLightbox() {
        if (lightbox.open) lightbox.close();
      }

      function createPhotoCard(photo, index) {
        const card = document.createElement("article");
        card.className = "photo-card";

        const button = document.createElement("button");
        button.type = "button";
        button.className = "photo-card-button";

        const uploadedLabel = formatUploadedLabel(photo.uploaded);
        button.setAttribute("aria-label", `Apri foto ${index + 1}, caricata ${uploadedLabel}`);
        button.addEventListener("click", () => openLightbox(photo.url, uploadedLabel));

        const media = document.createElement("div");
        media.className = "photo-media";

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = `Foto caricata ${uploadedLabel}`;
        img.loading = "lazy";
        img.decoding = "async";

        const meta = document.createElement("div");
        meta.className = "photo-meta";
        meta.textContent = uploadedLabel;

        media.appendChild(img);
        button.appendChild(media);
        card.appendChild(button);
        card.appendChild(meta);
        return card;
      }

      function renderPagination(totalPages) {
  pagination.innerHTML = "";

  if (totalPages <= 1) {
    pagination.hidden = true;
    return;
  }

  pagination.hidden = false;

  const pages = new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1]);

  const orderedPages = [...pages]
    .filter((page) => page >= 1 && page <= totalPages)
    .sort((a, b) => a - b);

  let lastPage = 0;

  orderedPages.forEach((page) => {
    if (page - lastPage > 1) {
      const dots = document.createElement("span");
      dots.className = "photo-page-dots";
      dots.textContent = "...";
      dots.setAttribute("aria-hidden", "true");
      pagination.appendChild(dots);
    }

    const button = document.createElement("button");
    button.type = "button";
    button.className = "photo-page-btn";
    button.textContent = String(page);
    button.setAttribute("aria-label", `Vai alla pagina ${page}`);

    if (page === currentPage) {
      button.dataset.active = "true";
      button.setAttribute("aria-current", "page");
    }

    button.addEventListener("click", () => {
      if (page === currentPage) return;
      currentPage = page;
      renderGallery();
    });

    pagination.appendChild(button);
    lastPage = page;
  });
}

      function renderGallery() {
        gallery.innerHTML = "";

        if (!allPhotos.length) {
          pagination.hidden = true;
          return;
        }

        const totalPages = Math.max(1, Math.ceil(allPhotos.length / PHOTOS_PER_PAGE));
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * PHOTOS_PER_PAGE;
        const visiblePhotos = allPhotos.slice(start, start + PHOTOS_PER_PAGE);
        const frag = document.createDocumentFragment();

        visiblePhotos.forEach((photo, index) => {
          frag.appendChild(createPhotoCard(photo, start + index));
        });

        gallery.appendChild(frag);
        renderPagination(totalPages);
      }

      async function loadPhotos() {
        try {
          showMessage("");
          const res = await fetch(`${workerBase}/photos`, { cache: "no-store" });
          if (!res.ok) throw new Error("Errore nel caricamento galleria");

          allPhotos = await res.json();
          photoCount.textContent = String(allPhotos.length);

          if (!allPhotos.length) {
            gallery.innerHTML = "";
            pagination.hidden = true;
            showMessage("");
            return;
          }

          currentPage = 1;
          renderGallery();
          showMessage("");
        } catch {
          showMessage("Non riesco a caricare la galleria.", true);
        }
      }

      async function uploadFiles() {
        if (!selectedFiles.length || isUploading) return;

        setUploadingState(true);
        showMessage("Sto caricando le foto...");

        try {
          const fd = new FormData();
          selectedFiles.forEach((file) => fd.append("photos", file));

          const res = await fetch(`${workerBase}/upload`, {
            method: "POST",
            body: fd
          });

          let data;
          try {
            data = await res.json();
          } catch {
            throw new Error("Risposta server non valida");
          }

          if (!res.ok || data?.error) {
            throw new Error(data?.error || "Upload fallito");
          }

          selectedFiles = [];
          cameraInput.value = "";
          galleryInput.value = "";
          updateSelectedFilesUI();
          showMessage("");
          await loadPhotos();
        } catch {
          showMessage("Upload non riuscito. Riprova.", true);
        } finally {
          setUploadingState(false);
          updateSelectedFilesUI();
        }
      }

      cameraInput?.addEventListener("change", (event) => addFiles(event.target.files));
      galleryInput?.addEventListener("change", (event) => addFiles(event.target.files));
      uploadBtn?.addEventListener("click", uploadFiles);
      refreshBtn?.addEventListener("click", loadPhotos);
      lightboxClose?.addEventListener("click", closeLightbox);

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      lightbox?.addEventListener("cancel", () => {
        lightboxImage.src = "";
        lightboxCaption.textContent = "";
      });

      lightbox?.addEventListener("close", () => {
        lightboxImage.src = "";
        lightboxCaption.textContent = "";
      });

      updateSelectedFilesUI();
      loadPhotos();
    </script>
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    background: var(--color-primary, #d7e3e8);
  }

  body {
    font-family: Montserrat, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--color-text-dark, #221b18);
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  .photo-page {
    min-height: 100vh;
    padding: 14px 10px 40px;
    background: linear-gradient(180deg, rgba(215, 227, 232, 0.94) 0%, rgba(236, 242, 245, 0.98) 100%);
  }

  .photo-wrap {
    width: min(100%, 1120px);
    margin: 0 auto;
  }

  .photo-box {
    border-radius: 24px;
    padding: 16px;
    margin-bottom: 16px;
    overflow: hidden;
    backdrop-filter: blur(4px);
  }

  .photo-box-upload,
  .photo-box-gallery {
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.34);
  }

  .photo-kicker {
    margin: 0 0 6px;
    font-size: 11px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-text-dark, #221b18);
    opacity: 0.78;
  }

  .photo-kicker-inline {
    margin: 0;
  }

  .photo-title {
    margin: 0 0 10px;
    line-height: 0.88;
    font-family: Montserrat, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--color-text-dark, #221b18);
  }

  .photo-text,
  .photo-message,
  .photo-selected,
  .photo-meta,
  .photo-lightbox-caption {
    margin: 0;
    line-height: 1.6;
    font-size: 15px;
  }

  .photo-text,
  .photo-selected,
  .photo-meta {
    color: var(--color-text-dark, #221b18);
    opacity: 0.88;
  }

  .photo-actions,
  .photo-head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .photo-actions {
    margin-top: 16px;
  }

  .photo-head {
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .photo-gallery-tools {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .photo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    font: inherit;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .photo-btn-primary {
    background: rgba(34, 27, 24, 0.9);
    border-color: rgba(34, 27, 24, 0.9);
    color: #ffffff;
  }

  .photo-btn-secondary,
  .photo-btn-soft {
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(34, 27, 24, 0.08);
    color: var(--color-text-dark, #221b18);
  }

  .photo-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .photo-btn:focus-visible,
  .photo-card-button:focus-visible,
  .photo-lightbox-close:focus-visible,
  .photo-refresh-icon:focus-visible,
  .photo-page-btn:focus-visible {
    outline: 3px solid rgba(34, 27, 24, 0.18);
    outline-offset: 3px;
  }

  .photo-selected {
    margin-top: 12px;
    word-break: break-word;
  }

  .photo-count-badge {
    min-width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(34, 27, 24, 0.08);
    color: var(--color-text-dark, #221b18);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .photo-refresh-icon {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(34, 27, 24, 0.08);
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-text-dark, #221b18);
    cursor: pointer;
    flex: 0 0 auto;
  }

  .photo-refresh-icon svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .photo-message {
    margin-bottom: 8px;
    color: var(--color-text-dark, #221b18);
    opacity: 0.82;
  }

  .photo-message:empty,
  .photo-message[hidden] {
    display: none;
  }

  .photo-message[data-error="true"] {
    color: #a04242;
    opacity: 1;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    margin-top: 14px;
  }

  .photo-card {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .photo-card-button {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
  }

  .photo-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.35);
  }

  .photo-media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    margin: 0;
  }

  .photo-meta {
    padding: 8px 10px 10px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .photo-pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .photo-pagination[hidden] {
    display: none;
  }

  .photo-page-btn {
    min-width: 34px;
    height: 34px;
    padding: 0 10px;
    border-radius: 999px;
    border: 1px solid rgba(34, 27, 24, 0.08);
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-text-dark, #221b18);
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }

  .photo-page-btn[data-active="true"] {
    background: rgba(34, 27, 24, 0.9);
    border-color: rgba(34, 27, 24, 0.9);
    color: #ffffff;
  }

  .photo-page-dots {
  min-width: 20px;
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-dark, #221b18);
  opacity: 0.55;
  font-size: 14px;
  font-weight: 700;
}

  .photo-lightbox {
    width: min(92vw, 960px);
    max-width: 960px;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .photo-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(4px);
  }

  .photo-lightbox-inner {
    position: relative;
  }

  .photo-lightbox-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    min-height: 42px;
    padding: 10px 14px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(34, 27, 24, 0.62);
    color: #fff;
    font: inherit;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .photo-lightbox-image {
    display: block;
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 18px;
    background: #111;
  }

  .photo-lightbox-caption {
    margin-top: 10px;
    text-align: center;
    color: #f2eee9;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 900px) {
    .photo-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
  }

  @media (max-width: 760px) {
    .photo-actions > * {
      width: 100%;
    }

    .photo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .photo-box {
      padding: 14px;
    }

    .photo-lightbox {
      width: calc(100vw - 20px);
    }
  }

  @media (max-width: 520px) {
    .photo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .photo-meta {
      font-size: 9px;
      padding: 6px 8px 8px;
    }

    .photo-pagination {
      gap: 6px;
    }

    .photo-page-btn {
      min-width: 32px;
      height: 32px;
      padding: 0 8px;
      font-size: 10px;
    }
  }
</style>