---
const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Foto matrimonio</title>
  </head>

  <body>
    <section class="photo-page">
      <div class="shell">
        <header class="hero">
          <p class="eyebrow">Album condiviso</p>
          <h1>Carica le tue foto del matrimonio</h1>
          <p class="intro">
            Puoi scattare una foto al momento oppure scegliere immagini già presenti sul telefono. Poi premi il pulsante di upload per aggiungerle alla galleria condivisa.
          </p>

          <div class="hero-actions">
            <label for="camera-input" class="btn btn-primary">Scatta una foto</label>
            <label for="gallery-input" class="btn btn-secondary">Scegli dalla galleria</label>
            <button id="upload-btn" class="btn btn-accent" type="button" disabled>Carica adesso</button>
          </div>

          <input id="camera-input" class="sr-only" type="file" accept="image/*" capture="environment" />
          <input id="gallery-input" class="sr-only" type="file" accept="image/*" multiple />

          <p id="selected-files" class="selected-files">Nessuna foto selezionata.</p>

          <div class="status-grid">
            <div class="status-card">
              <span class="status-label">Stato upload</span>
              <strong id="upload-status">Pronto</strong>
            </div>
            <div class="status-card">
              <span class="status-label">Foto visibili</span>
              <strong id="photo-count">0</strong>
            </div>
          </div>
        </header>

        <section id="gallery" class="gallery-section">
          <div class="section-head">
            <div>
              <p class="panel-kicker">Galleria live</p>
              <h2>Tutte le foto degli invitati</h2>
            </div>
            <button id="refresh-btn" class="btn btn-ghost" type="button">Aggiorna</button>
          </div>

          <p id="message" class="message" role="status" aria-live="polite">Sto caricando la galleria...</p>
          <div id="gallery-grid" class="gallery-grid"></div>
        </section>
      </div>
    </section>

    <script type="module">
      const workerBase = "https://wedding-worker.stefano-penzo23.workers.dev";

      const cameraInput = document.getElementById("camera-input");
      const galleryInput = document.getElementById("gallery-input");
      const uploadBtn = document.getElementById("upload-btn");
      const selectedFilesText = document.getElementById("selected-files");
      const gallery = document.getElementById("gallery-grid");
      const message = document.getElementById("message");
      const uploadStatus = document.getElementById("upload-status");
      const photoCount = document.getElementById("photo-count");
      const refreshBtn = document.getElementById("refresh-btn");

      let selectedFiles = [];

      function showMessage(text, isError = false) {
        message.textContent = text;
        message.dataset.error = isError ? "true" : "false";
      }

      function updateSelectedFilesUI() {
        if (!selectedFiles.length) {
          selectedFilesText.textContent = "Nessuna foto selezionata.";
          uploadBtn.disabled = true;
          return;
        }

        const names = selectedFiles.slice(0, 2).map((file) => file.name).join(", ");
        const extra = selectedFiles.length > 2 ? ` +${selectedFiles.length - 2} altre` : "";
        selectedFilesText.textContent = `${selectedFiles.length} foto selezionate: ${names}${extra}`;
        uploadBtn.disabled = false;
      }

      function setSelectedFiles(files, mode = "replace") {
        const next = Array.from(files || []);
        if (!next.length) return;

        if (mode === "append") {
          selectedFiles = [...selectedFiles, ...next];
        } else {
          selectedFiles = next;
        }

        updateSelectedFilesUI();
      }

      function createPhotoCard(photo) {
        const article = document.createElement("article");
        article.className = "photo-card";

        const link = document.createElement("a");
        link.href = photo.url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.className = "photo-trigger";
        link.setAttribute("aria-label", "Apri foto intera");

        const frame = document.createElement("div");
        frame.className = "photo-frame";

        const img = document.createElement("img");
        img.src = photo.url;
        img.alt = "Foto caricata dagli invitati";
        img.loading = "lazy";
        img.decoding = "async";
        img.width = 1200;
        img.height = 1500;

        frame.appendChild(img);
        link.appendChild(frame);

        const meta = document.createElement("div");
        meta.className = "photo-meta";

        const date = photo.uploaded ? new Date(photo.uploaded) : null;
        meta.textContent =
          date && !Number.isNaN(date.getTime())
            ? date.toLocaleString("it-IT", { dateStyle: "short", timeStyle: "short" })
            : "Appena caricata";

        article.append(link, meta);
        return article;
      }

      async function loadPhotos() {
        try {
          showMessage("Sto caricando la galleria...");
          const res = await fetch(`${workerBase}/photos`, { cache: "no-store" });
          if (!res.ok) throw new Error("Errore nel caricamento");
          const photos = await res.json();

          gallery.innerHTML = "";
          photoCount.textContent = String(photos.length);

          if (!photos.length) {
            showMessage("Nessuna foto caricata per ora. Sii il primo a condividere uno scatto.");
            return;
          }

          const fragment = document.createDocumentFragment();
          photos.forEach((photo) => fragment.appendChild(createPhotoCard(photo)));
          gallery.appendChild(fragment);
          showMessage(`Galleria aggiornata: ${photos.length} foto disponibili.`);
        } catch {
          showMessage("Non riesco a caricare la galleria in questo momento.", true);
        }
      }

      async function uploadFiles() {
        if (!selectedFiles.length) return;

        uploadBtn.disabled = true;
        uploadStatus.textContent = "Caricamento...";
        showMessage(`Sto caricando ${selectedFiles.length} foto...`);

        try {
          const fd = new FormData();
          selectedFiles.forEach((file) => fd.append("photos", file));

          const res = await fetch(`${workerBase}/upload`, {
            method: "POST",
            body: fd
          });

          const data = await res.json();
          if (!res.ok || data.error) throw new Error(data.error || "Upload fallito");

          uploadStatus.textContent = "Completato";

          const uploadedCount = data.uploaded?.length || 0;
          const skippedCount = data.skipped?.length || 0;

          showMessage(
            skippedCount
              ? `Caricate ${uploadedCount} foto. ${skippedCount} file sono stati saltati.`
              : `Caricate ${uploadedCount} foto con successo.`
          );

          selectedFiles = [];
          cameraInput.value = "";
          galleryInput.value = "";
          updateSelectedFilesUI();
          await loadPhotos();
        } catch {
          uploadStatus.textContent = "Errore";
          showMessage("Upload non riuscito. Riprova tra qualche secondo.", true);
          uploadBtn.disabled = false;
        }
      }

      cameraInput?.addEventListener("change", (event) => {
        setSelectedFiles(event.target.files, "append");
      });

      galleryInput?.addEventListener("change", (event) => {
        setSelectedFiles(event.target.files, "append");
      });

      uploadBtn?.addEventListener("click", uploadFiles);
      refreshBtn?.addEventListener("click", loadPhotos);

      updateSelectedFilesUI();
      loadPhotos();
      setInterval(loadPhotos, 20000);
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #faf7f2;
    --surface: rgba(255, 255, 255, 0.9);
    --surface-strong: #ffffff;
    --text: #221b18;
    --muted: #6e625c;
    --line: rgba(34, 27, 24, 0.1);
    --accent: #9f6f5a;
    --accent-dark: #7f5644;
    --accent-soft: #efe3db;
    --shadow: 0 20px 60px rgba(70, 44, 34, 0.12);
    --radius: 24px;
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .photo-page {
    background: radial-gradient(circle at top, rgba(159, 111, 90, 0.12), transparent 30%), var(--bg);
    min-height: 100vh;
    padding: 4rem 1.25rem 6rem;
  }

  .shell {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    gap: 1.5rem;
  }

  .hero,
  .gallery-section {
    background: var(--surface);
    backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .hero {
    padding: 2rem;
    text-align: center;
  }

  .eyebrow,
  .panel-kicker,
  .status-label {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 4.3rem);
    line-height: 1.04;
    margin: 0.75rem auto 1rem;
    max-width: 12ch;
  }

  h2 {
    font-size: clamp(1.45rem, 3vw, 2.1rem);
    line-height: 1.1;
    margin: 0.35rem 0 0.75rem;
  }

  .intro,
  .message,
  .photo-meta,
  .selected-files {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .intro {
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-actions,
  .section-head,
  .status-grid {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero-actions,
  .status-grid {
    justify-content: center;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 0;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid transparent;
    font-weight: 600;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    white-space: normal;
    text-align: center;
  }

  .btn-primary {
    background: var(--accent);
    color: white;
  }

  .btn-primary:hover {
    background: var(--accent-dark);
  }

  .btn-accent {
    background: var(--accent-soft);
    border-color: rgba(159, 111, 90, 0.24);
  }

  .btn-secondary,
  .btn-ghost {
    border-color: var(--line);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .selected-files {
    margin-top: 1rem;
    word-break: break-word;
  }

  .status-card {
    min-width: 155px;
    background: var(--surface-strong);
    border-radius: 18px;
    border: 1px solid var(--line);
    padding: 1rem 1.1rem;
    text-align: left;
  }

  .status-card strong {
    display: block;
    font-size: 1.2rem;
    margin-top: 0.35rem;
  }

  .gallery-section {
    padding: 1.4rem;
  }

  .section-head {
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .message[data-error="true"] {
    color: #a04242;
  }

  .gallery-grid {
    margin-top: 1.1rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: start;
  }

  .photo-card {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: 18px;
    background: var(--surface-strong);
    border: 1px solid var(--line);
    box-shadow: 0 8px 24px rgba(70, 44, 34, 0.06);
  }

  .photo-trigger {
    display: block;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .photo-frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #efe7df;
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .photo-meta {
    padding: 0.72rem 0.82rem 0.9rem;
    font-size: 0.9rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .gallery-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .photo-page {
      padding: 1rem 0.85rem 4rem;
    }

    .hero {
      padding: 1.35rem;
      text-align: left;
    }

    .hero-actions > *,
    .section-head > *,
    .btn {
      width: 100%;
    }

    .status-grid {
      justify-content: stretch;
    }

    .status-card {
      width: 100%;
      min-width: 0;
    }
  }
</style>